    },
    "var_2ee98a58d9e8": {
      "type": "variant",
      "label": "03 — Project dossier review",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n</style>\n<div class=\"m-0 flex h-[960px] w-full flex-col overflow-hidden bg-[#111417] font-[IBM_Plex_Sans,Arial,sans-serif] text-[#eff2f3] antialiased\" data-kid=\"1\">\n    <header class=\"flex h-[62px] shrink-0 items-center justify-between border-b border-[#30363a] bg-[#171b1e] px-5\" data-kid=\"1-1\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\">\n            <img alt=\"Estelar MapTools\" class=\"h-[38px] w-[38px] shrink-0 object-contain\" data-kid=\"1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/ui/assets/logo.png\"/>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\">\n                <div class=\"truncate text-[15px] font-semibold tracking-[-0.02em] text-[#f4f5f6]\" data-kid=\"1-1-1-2-1\">\n                    EstelarMapTools\n                </div>\n                <div class=\"text-[11px] text-[#9ca6ac]\" data-kid=\"1-1-1-2-2\">\n                    Projeto de mapa de localização\n                </div>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-1 text-[15px] text-[#a9b1b6]\" data-kid=\"1-1-2\">\n            <button aria-label=\"Minimizar janela\" class=\"flex h-8 w-8 items-center justify-center rounded-md hover:bg-[#272c30]\" data-kid=\"1-1-2-1\">\n                <i class=\"ph ph-minus\" data-kid=\"1-1-2-1-1\">\n                </i>\n            </button>\n            <button aria-label=\"Fechar janela\" class=\"flex h-8 w-8 items-center justify-center rounded-md hover:bg-[#272c30]\" data-kid=\"1-1-2-2\">\n                <i class=\"ph ph-x\" data-kid=\"1-1-2-2-1\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"flex min-h-0 flex-1\" data-kid=\"1-2\">\n        <aside class=\"flex w-[344px] shrink-0 flex-col border-r border-[#30363a] bg-[#15191c]\" data-kid=\"1-2-1\">\n            <div class=\"min-h-0 flex-1 overflow-y-auto px-5 pb-4 pt-5\" data-kid=\"1-2-1-1\">\n                <h1 class=\"mb-4 text-[18px] font-semibold tracking-[-0.025em] text-[#f4f5f6]\" data-kid=\"1-2-1-1-1\">\n                    Configuração do projeto\n                </h1>\n                <section class=\"border-b border-[#2b3135] pb-4\" data-kid=\"1-2-1-1-2\">\n                    <label class=\"mb-1.5 block text-[12px] font-medium text-[#c2c9cd]\" data-kid=\"1-2-1-1-2-1\">\n                        Nome da obra\n                        <span class=\"text-[#d79851]\" data-kid=\"1-2-1-1-2-1-1\">\n                            *\n                        </span>\n                    </label>\n                    <div class=\"flex h-9 items-center rounded-md border border-[#3a4145] bg-[#1d2225] px-3 text-[13px] text-[#798287]\" data-kid=\"1-2-1-1-2-2\">\n                        <span class=\"flex-1\" data-kid=\"1-2-1-1-2-2-1\">\n                            Selecione ou digite a obra\n                        </span>\n                        <i class=\"ph ph-caret-down text-[13px]\" data-kid=\"1-2-1-1-2-2-2\">\n                        </i>\n                    </div>\n                    <div class=\"mt-3\" data-kid=\"1-2-1-1-2-3\">\n                        <label class=\"mb-1.5 block text-[12px] font-medium text-[#c2c9cd]\" data-kid=\"1-2-1-1-2-3-1\">\n                            Perfil rápido\n                        </label>\n                        <div class=\"flex h-9 items-center rounded-md border border-[#3a4145] bg-[#1d2225] px-3 text-[13px] text-[#e7ebed]\" data-kid=\"1-2-1-1-2-3-2\">\n                            <span class=\"flex-1\" data-kid=\"1-2-1-1-2-3-2-1\">\n                                Padrão\n                            </span>\n                            <i class=\"ph ph-caret-down text-[#99a3a8]\" data-kid=\"1-2-1-1-2-3-2-2\">\n                            </i>\n                        </div>\n                    </div>\n                    <div class=\"mt-3 grid grid-cols-2 gap-3\" data-kid=\"1-2-1-1-2-4\">\n                        <div data-kid=\"1-2-1-1-2-4-1\">\n                            <label class=\"mb-1.5 block text-[12px] font-medium text-[#c2c9cd]\" data-kid=\"1-2-1-1-2-4-1-1\">\n                                Tipo de projeto\n                            </label>\n                            <div class=\"flex h-9 items-center rounded-md border border-[#3a4145] bg-[#1d2225] px-3 text-[13px] text-[#e7ebed]\" data-kid=\"1-2-1-1-2-4-1-2\">\n                                <span class=\"flex-1\" data-kid=\"1-2-1-1-2-4-1-2-1\">\n                                    PCH\n                                </span>\n                                <i class=\"ph ph-caret-down text-[#99a3a8]\" data-kid=\"1-2-1-1-2-4-1-2-2\">\n                                </i>\n                            </div>\n                        </div>\n                        <div data-kid=\"1-2-1-1-2-4-2\">\n                            <label class=\"mb-1.5 block text-[12px] font-medium text-[#c2c9cd]\" data-kid=\"1-2-1-1-2-4-2-1\">\n                                Zona UTM\n                            </label>\n                            <div class=\"flex h-9 items-center rounded-md border border-[#3a4145] bg-[#1d2225] px-3 text-[13px] text-[#e7ebed]\" data-kid=\"1-2-1-1-2-4-2-2\">\n                                <span class=\"flex-1\" data-kid=\"1-2-1-1-2-4-2-2-1\">\n                                    Automático\n                                </span>\n                                <i class=\"ph ph-caret-down text-[#99a3a8]\" data-kid=\"1-2-1-1-2-4-2-2-2\">\n                                </i>\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"mt-3 flex h-8 items-center gap-2 text-[12px] text-[#c2c9cd]\" data-kid=\"1-2-1-1-2-5\">\n                        <span class=\"h-4 w-4 rounded border border-[#5a6469]\" data-kid=\"1-2-1-1-2-5-1\">\n                        </span>\n                        Campos avançados\n                        <i class=\"ph ph-caret-down ml-1 text-[#899398]\" data-kid=\"1-2-1-1-2-5-2\">\n                        </i>\n                    </button>\n                </section>\n                <section class=\"border-b border-[#2b3135] py-4\" data-kid=\"1-2-1-1-3\">\n                    <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-2-1-1-3-1\">\n                        <h2 class=\"text-[14px] font-semibold text-[#e9edef]\" data-kid=\"1-2-1-1-3-1-1\">\n                            Arquivo de entrada\n                            <span class=\"font-normal text-[#d79851]\" data-kid=\"1-2-1-1-3-1-1-1\">\n                                *\n                            </span>\n                        </h2>\n                        <span class=\"text-[11px] text-[#d4a064]\" data-kid=\"1-2-1-1-3-1-2\">\n                            Pendente\n                        </span>\n                    </div>\n                    <button class=\"flex h-9 w-full items-center justify-center gap-2 rounded-md border border-[#4a5358] bg-[#202629] text-[13px] font-medium text-[#e4e8ea] hover:bg-[#282f33]\" data-kid=\"1-2-1-1-3-2\">\n                        <i class=\"ph ph-folder-open text-[16px]\" data-kid=\"1-2-1-1-3-2-1\">\n                        </i>\n                        Selecionar KML/KMZ\n                    </button>\n                    <div class=\"mt-2 flex items-center gap-2 text-[12px] text-[#aab3b8]\" data-kid=\"1-2-1-1-3-3\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#d79851]\" data-kid=\"1-2-1-1-3-3-1\">\n                        </span>\n                        Nenhum arquivo selecionado\n                    </div>\n                    <p class=\"mt-2 text-[12px] leading-[1.5] text-[#99a3a8]\" data-kid=\"1-2-1-1-3-4\">\n                        Município, zona e área serão detectados após carregar o KML.\n                    </p>\n                </section>\n                <section class=\"border-b border-[#2b3135] py-4\" data-kid=\"1-2-1-1-4\">\n                    <h2 class=\"mb-2 text-[14px] font-semibold text-[#e9edef]\" data-kid=\"1-2-1-1-4-1\">\n                        Pasta de destino\n                        <span class=\"font-normal text-[#d79851]\" data-kid=\"1-2-1-1-4-1-1\">\n                            *\n                        </span>\n                    </h2>\n                    <div class=\"flex gap-2\" data-kid=\"1-2-1-1-4-2\">\n                        <div class=\"flex h-9 min-w-0 flex-1 items-center rounded-md border border-[#3a4145] bg-[#1d2225] px-3 text-[12px] text-[#798287]\" data-kid=\"1-2-1-1-4-2-1\">\n                            Selecione a pasta para salvar\n                        </div>\n                        <button aria-label=\"Selecionar pasta de destino\" class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-[#414a4f] bg-[#202629] text-[#c3cbd0]\" data-kid=\"1-2-1-1-4-2-2\">\n                            <i class=\"ph ph-folder text-[16px]\" data-kid=\"1-2-1-1-4-2-2-1\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"mt-2 flex items-center gap-4 text-[12px]\" data-kid=\"1-2-1-1-4-3\">\n                        <button class=\"flex items-center gap-1.5 text-[#aeb7bc]\" data-kid=\"1-2-1-1-4-3-1\">\n                            <i class=\"ph ph-folder-open\" data-kid=\"1-2-1-1-4-3-1-1\">\n                            </i>\n                            Abrir pasta\n                        </button>\n                        <button class=\"flex items-center gap-1.5 text-[#aeb7bc]\" data-kid=\"1-2-1-1-4-3-2\">\n                            <i class=\"ph ph-copy\" data-kid=\"1-2-1-1-4-3-2-1\">\n                            </i>\n                            Copiar caminho\n                        </button>\n                    </div>\n                    <p class=\"mt-2 text-[12px] leading-[1.45] text-[#99a3a8]\" data-kid=\"1-2-1-1-4-4\">\n                        O GeoPackage será copiado para BASES. A origem da rede não será alterada.\n                    </p>\n                </section>\n                <section class=\"py-4\" data-kid=\"1-2-1-1-5\">\n                    <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-2-1-1-5-1\">\n                        <h2 class=\"text-[14px] font-semibold text-[#e9edef]\" data-kid=\"1-2-1-1-5-1-1\">\n                            Pendências para gerar\n                        </h2>\n                        <span class=\"text-[12px] text-[#aab3b8]\" data-kid=\"1-2-1-1-5-1-2\">\n                            3 obrigatórias\n                        </span>\n                    </div>\n                    <ul class=\"space-y-2 text-[12px] leading-[1.45] text-[#c7cdd0]\" data-kid=\"1-2-1-1-5-2\">\n                        <li class=\"flex items-start gap-2\" data-kid=\"1-2-1-1-5-2-1\">\n                            <span class=\"mt-[5px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#d79851]\" data-kid=\"1-2-1-1-5-2-1-1\">\n                            </span>\n                            <span data-kid=\"1-2-1-1-5-2-1-2\">\n                                Informe o nome da obra\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-2\" data-kid=\"1-2-1-1-5-2-2\">\n                            <span class=\"mt-[5px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#d79851]\" data-kid=\"1-2-1-1-5-2-2-1\">\n                            </span>\n                            <span data-kid=\"1-2-1-1-5-2-2-2\">\n                                Carregue um arquivo KML/KMZ\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-2\" data-kid=\"1-2-1-1-5-2-3\">\n                            <span class=\"mt-[5px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#d79851]\" data-kid=\"1-2-1-1-5-2-3-1\">\n                            </span>\n                            <span data-kid=\"1-2-1-1-5-2-3-2\">\n                                Selecione uma pasta de destino\n                            </span>\n                        </li>\n                    </ul>\n                    <button class=\"mt-3 flex items-center gap-1.5 text-[12px] text-[#9da7ac]\" data-kid=\"1-2-1-1-5-3\">\n                        <i class=\"ph ph-terminal-window\" data-kid=\"1-2-1-1-5-3-1\">\n                        </i>\n                        Ver log do sistema\n                        <i class=\"ph ph-caret-down ml-1\" data-kid=\"1-2-1-1-5-3-2\">\n                        </i>\n                    </button>\n                </section>\n            </div>\n        </aside>\n        <section class=\"flex min-w-0 flex-1 flex-col bg-[#111417]\" data-kid=\"1-2-2\">\n            <div class=\"flex h-[54px] shrink-0 items-center justify-between px-6\" data-kid=\"1-2-2-1\">\n                <div class=\"flex items-baseline gap-3\" data-kid=\"1-2-2-1-1\">\n                    <h2 class=\"text-[15px] font-semibold text-[#eff2f3]\" data-kid=\"1-2-2-1-1-1\">\n                        Mapa\n                    </h2>\n                    <span class=\"text-[12px] text-[#909ba1]\" data-kid=\"1-2-2-1-1-2\">\n                        Visualização do empreendimento\n                    </span>\n                </div>\n                <button class=\"flex h-8 items-center gap-2 rounded-md border border-[#343b3f] bg-[#191e21] px-3 text-[12px] text-[#d7dcdf]\" data-kid=\"1-2-2-1-2\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#4c91df]\" data-kid=\"1-2-2-1-2-1\">\n                    </span>\n                    Satélite\n                    <i class=\"ph ph-caret-down ml-1 text-[#9da7ac]\" data-kid=\"1-2-2-1-2-2\">\n                    </i>\n                </button>\n            </div>\n     