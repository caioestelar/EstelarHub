 </div>\n                            <div class=\"relative flex h-6 items-center\" data-kid=\"1-2-3-1-1-2-3-3\" data-name=\"layout 3 slider track container\">\n                                <div class=\"h-[3px] w-full rounded-full bg-[#3d4246]\" data-kid=\"1-2-3-1-1-2-3-3-1\" data-name=\"slider background\">\n                                </div>\n                                <div class=\"absolute left-0 h-[3px] w-[1.25%] rounded-full bg-[#64c39a]\" data-kid=\"1-2-3-1-1-2-3-3-2\" data-name=\"slider active fill\">\n                                </div>\n                                <div class=\"absolute left-[1.25%] h-3.5 w-3.5 -translate-x-1/2 rounded-full border-2 border-[#171a1c] bg-[#64c39a]\" data-kid=\"1-2-3-1-1-2-3-3-3\" data-name=\"slider handle\">\n                                </div>\n                            </div>\n                            <button class=\"flex h-8 items-center justify-center gap-1.5 rounded-md border border-[#41464b] px-2 text-[12px] text-[#c7cbd0]\" data-kid=\"1-2-3-1-1-2-3-4\" data-name=\"layout 3 lock state button\">\n                                <i class=\"ti ti-lock-open text-[15px]\" data-kid=\"1-2-3-1-1-2-3-4-1\" data-name=\"lock icon\">\n                                </i>\n                                Livre\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"mt-2 flex items-center gap-2 border-t border-[#343a3e] pt-2 text-[11px] text-[#9ba2a9]\" data-kid=\"1-2-3-1-1-3\" data-name=\"layouts section footer\">\n                        <i class=\"ti ti-info-circle text-[14px]\" data-kid=\"1-2-3-1-1-3-1\" data-name=\"info icon\">\n                        </i>\n                        Os centros destravados acompanham o arraste do mapa.\n                    </div>\n                </div>\n                <aside aria-label=\"Espécimes do padrão Estelar\" class=\"flex flex-col gap-2.5\" data-kid=\"1-2-3-1-2\" data-name=\"patterns example sidebar\">\n                    <div class=\"rounded-2xl border border-white bg-[#171a1c] p-4 shadow-[0_12px_30px_rgba(0,0,0,0.15)]\" data-kid=\"1-2-3-1-2-1\" data-name=\"reusable pattern card\">\n                        <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"pattern card header\">\n                            <h3 class=\"text-[11px] font-semibold uppercase tracking-[.09em] text-[#aeb6bd]\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"pattern card title\">\n                                Padrão reutilizável\n                            </h3>\n                            <span class=\"rounded-full border border-[#384149] px-2 py-0.5 text-[9px] text-[#929ba2]\" data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"pattern card badge\">\n                                UI + Hub\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-2.5 rounded-xl bg-[#202529] px-3 py-2.5\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"tool card detail container\">\n                            <div class=\"grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-[#263c55] text-[#8bb8f5]\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"tool card icon container\">\n                                <i class=\"ti ti-map-2 text-[17px]\" data-kid=\"1-2-3-1-2-1-2-1-1\" data-name=\"map tool icon\">\n                                </i>\n                            </div>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"1-2-3-1-2-1-2-2\" data-name=\"tool card text content\">\n                                <div class=\"text-[11px] font-semibold text-[#edf0f2]\" data-kid=\"1-2-3-1-2-1-2-2-1\" data-name=\"tool card title\">\n                                    Cartão de ferramenta\n                                </div>\n                                <div class=\"text-[10px] text-[#9ba5ac]\" data-kid=\"1-2-3-1-2-1-2-2-2\" data-name=\"tool card subtitle\">\n                                    EstelarHub · sem moldura interna\n                                </div>\n                            </div>\n                            <span class=\"rounded-md bg-[#153326] px-1.5 py-1 text-[9px] font-semibold text-[#81d1a5]\" data-kid=\"1-2-3-1-2-1-2-3\" data-name=\"active status badge\">\n                                ATIVO\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex min-h-0 flex-1 items-center gap-3 rounded-2xl border border-white bg-[#171a1c] p-4 shadow-[0_12px_30px_rgba(0,0,0,0.15)]\" data-kid=\"1-2-3-1-2-2\" data-name=\"QPT example card\">\n                        <div class=\"flex h-[84px] w-[62px] shrink-0 items-center justify-center p-1\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"QPT preview container\">\n                            <div class=\"relative h-full w-full rounded-[16px] border border-white bg-[#171a1c] p-1.5 shadow-[0_8px_22px_rgba(0,0,0,0.15)]\" data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"QPT visual representation\">\n                                <div class=\"mb-1.5 h-1 w-6 rounded-full bg-[#87929a]\" data-kid=\"1-2-3-1-2-2-1-1-1\" data-name=\"QPT preview line\">\n                                </div>\n                                <div class=\"h-[1px] w-full bg-white/40\" data-kid=\"1-2-3-1-2-2-1-1-2\" data-name=\"QPT preview divider\">\n                                </div>\n                                <div class=\"absolute bottom-2 left-2 right-2 h-5 rounded-[7px] border border-white bg-[#31383d] shadow-[0_4px_10px_rgba(0,0,0,0.15)]\" data-kid=\"1-2-3-1-2-2-1-1-3\" data-name=\"QPT preview box\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"QPT card text description\">\n                            <div class=\"mb-1 text-[10px] font-semibold uppercase tracking-[.08em] text-[#aeb6bd]\" data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"QPT title text\">\n                                QPT · amostra conceitual\n                            </div>\n                            <div class=\"text-[11px] font-medium text-[#e6e9ec]\" data-kid=\"1-2-3-1-2-2-2-2\" data-name=\"QPT label text\">\n                                Quadro 1 px · 16 px\n                            </div>\n                            <div class=\"mt-1 text-[10px] leading-[1.4] text-[#969fa6]\" data-kid=\"1-2-3-1-2-2-2-3\" data-name=\"QPT detail text\">\n                                Sombra 15% · margem interna 16 px\n                                <br data-kid=\"1-2-3-1-2-2-2-3-1\" data-name=\"line break\"/>\n                                Não é um template verificado.\n                            </div>\n                        </div>\n                    </div>\n                </aside>\n            </div>\n        </section>\n    </main>\n    <footer class=\"flex min-h-[66px] shrink-0 items-center justify-between border-t border-[#2d3236] bg-[#151719] px-7\" data-kid=\"1-3\" data-name=\"footer section\">\n        <button class=\"inline-flex h-9 items-center gap-2 rounded-md px-2 text-[13px] font-medium text-[#a2a8ae]\" data-kid=\"1-3-1\" data-name=\"reset template button\">\n            <i class=\"ti ti-rotate-2 text-[16px]\" data-kid=\"1-3-1-1\" data-name=\"rotate icon\">\n            </i>\n            Resetar template\n        </button>\n        <div class=\"flex items-center gap-4\" data-kid=\"1-3-2\" data-name=\"generator controls container\">\n            <span class=\"text-[12px] text-[#969da4]\" data-kid=\"1-3-2-1\" data-name=\"generator instruction text\">\n                Importe um arquivo e selecione a pasta de destino para continuar.\n            </span>\n            <button class=\"inline-flex h-10 min-w-[174px] items-center justify-center gap-2 rounded-md border border-[#343a40] bg-[#22272b] px-4 text-[13px] font-semibold text-[#858c92]\" data-kid=\"1-3-2-2\" data-name=\"generate project button\" disabled=\"\">\n                <i class=\"ti ti-player-play-filled text-[14px]\" data-kid=\"1-3-2-2-1\" data-name=\"play icon\">\n                </i>\n                Gerar projeto\n            </button>\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-10-05T12:28:44.247760+00:00",
      "modified": "2026-10-05T12:37:04.162573+00:00",
      "id": "var_019e72e4df54"
    },
    "var_988d37646207": {
      "type": "variant",
      "label": "03 — Project dossier · quadro padrão",
      "parentId": "var_2ee98a58d9e8",
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 960
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n.map-image { background-image: linear-gradient(180deg, rgba(13,20,22,.12), rgba(13,20,22,.23)), url('/api/local/images/.kombai/canvas/assets/estelar-original-workspace.png'); background-size: 3460px auto; background-position: -820px -714px; }\n.frame-shadow { box-shadow: 0 10px 26px rgba(0,0,0,.15); }\n.scale-track { background: #353d41; }\n</style>\n<div class=\"flex h-[960px] w-full min-w-[1280px] flex-col overflow-hidden bg-[#111417] font-['IBM_Plex_Sans',sans-serif] text-[#eff2f3] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"flex h-[62px] shrink-0 items-center justify-between border-b border-[#30363a] bg-[#171b1e] px-5\" data-kid=\"1-1\" data-name=\"header bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"logo and title group\">\n            <img alt=\"Logotipo EstelarMapTools\" class=\"h-[38px] w-[38px] shrink-0 object-contain\" data-kid=\"1-1-1-1\" data-name=\"EstelarMapTools logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/logo.png\"/>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\" data-name=\"application title container\">\n                <div class=\"truncate text-[15px] font-semibold tracking-[-0.02em] text-[#f4f5f6]\" data-kid=\"1-1-1-2-1\" data-name=\"application name text\">\n                    EstelarMapTools\n                </div>\n                <div class=\"text-[11px] text-[#9ca6ac]\" data-kid=\"1-1-1-2-2\" data-name=\"application subtitle text\">\n                    Projeto de mapa de localização\n                </div>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-1 text-[15px] text-[#a9b1b6]\" data-kid=\"1-1-2\" data-name=\"window control buttons\">\n            <button aria-label=\"Minimizar janela\" class=\"flex h-8 w-8 items-center justify-center rounded-md hover:bg-[#272c30]\" data-kid=\"1-1-2-1\" data-name=\"minimize window button\">\n                <i class=\"ph ph-minus\" data-kid=\"1-1-2-1-1\" data-name=\"minus icon\">\n                </i>\n            </button>\n            <button aria-label=\"Fechar janela\" class=\"flex h-8 w-8 items-center justify-center rounded-md hover:bg-[#272c30]\" data-kid=\"1-1-2-2\" data-name=\"close window button\">\n                <i class=\"ph ph-x\" data-kid=\"1-1-2-2-1\" data-name=\"close icon\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"flex min-h-0 flex-1\" data-kid=\"1-2\" data-name=\"main content area\">\n        <aside class=\"flex w-[344px] shrink-0 flex-col border-r border-[#30363a] bg-[#15191c]\" data-kid=\"1-2-1\" data-name=\"configuration sidebar\">\n            <div class=\"min-h-0 flex-1 overflow-y-auto p-4\" data-kid=\"1-2-1-1\" data-name=\"sidebar scrollable area\">\n                <section class=\"frame-shadow rounded-2xl border border-white bg-[#191e21] p-4\" data-kid=\"1-2-1-1-1\" data-name=\"project configuration panel\">\n                    <h1 class=\"mb-4 text-[16px] font-semibold tracking-[-0.02em] text-[#f4f5f6]\" data-kid=\"1-2-1-1-1-1\" data-name=\"configuration title\">\n                        Configuração do projeto\n                    </h1>\n                    <div class=\"space-y-3.5\" data-kid=\"1-2-1-1-1-2\" data-name=\"configuration input stack\">\n                        <div data-kid=\"1-2-1-1-1-2-1\" data-name=\"work name input field group\">\n                            <label class=\"mb-1.5 block text-[12px] font-medium text-[#c2c9cd]\" data-kid=\"1-2-1-1-1-2-1-1\" data-name=\"work name label\">\n                                Nome da obra\n                                <span class=\"text-[#d79851]\" data-kid=\"1-2-1-1-1-2-1-1-1\" data-name=\"required field asterisk\">\n                                    *\n                                </span>\n                            </label>\n                            <div class=\"flex h-9 items-center rounded-md border border-[#3a4145] bg-[#1d2225] px-3 text-[13px] text-[#798287]\" data-kid=\"1-2-1-1-1-2-1-2\" data-name=\"work name input display\">\n                                Selecione ou digite a obra\n                                <i class=\"ph ph-caret-down ml-auto text-[#99a3a8]\" data-kid=\"1-2-1-1-1-2-1-2-1\" data-name=\"dropdown icon\">\n                                </i>\n                            </div>\n                        </div>\n                        <div data-kid=\"1-2-1-1-1-2-2\" data-name=\"quick profile input group\">\n                            <label class=\"mb-1.5 block text-[12px] font-medium text-[#c2c9cd]\" data-kid=\"1-2-1-1-1-2-2-1\" data-name=\"quick profile label\">\n                                Perfil rápido\n                            </label>\n                            <div class=\"flex h-9 items-center rounded-md border border-[#3a4145] bg-[#1d2225] px-3 text-[13px] text-[#e7ebed]\" data-kid=\"1-2-1-1-1-2-2-2\" data-name=\"quick profile input display\">\n                                Padrão\n                                <i class=\"ph ph-caret-down ml-auto text-[#99a3a8]\" data-kid=\"1-2-1-1-1-2-2-2-1\" data-name=\"dropdown icon\">\n                                </i>\n                            </div>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-3\" data-kid=\"1-2-1-1-1-2-3\" data-name=\"grid input group\">\n                            <div data-kid=\"1-2-1-1-1-2-3-1\" data-name=\"project type input group\">\n                                <label class=\"mb-1.5 block text-[12px] font-medium text-[#c2c9cd]\" data-kid=\"1-2-1-1-1-2-3-1-1\" data-name=\"project type label\">\n                                    Tipo de projeto\n                                </label>\n                                <div class=\"flex h-9 items-center rounded-md border border-[#3a4145] bg-[#1d2225] px-3 text-[13px] text-[#e7ebed]\" data-kid=\"1-2-1-1-1-2-3-1-2\" data-name=\"project type input display\">\n                                    PCH\n                                    <i class=\"ph ph-caret-down ml-auto text-[#99a3a8]\" data-kid=\"1-2-1-1-1-2-3-1-2-1\" data-name=\"dropdown icon\">\n                                    </i>\n                                </div>\n                            </div>\n                            <div data-kid=\"1-2-1-1-1-2-3-2\" data-name=\"UTM zone input group\">\n                                <label class=\"mb-1.5 block text-[12px] font-medium text-[#c2c9cd]\" data-kid=\"1-2-1-1-1-2-3-2-1\" data-name=\"UTM zone label\">\n                                    Zona UTM\n                                </label>\n                                <div class=\"flex h-9 items-center rounded-md border border-[#3a4145] bg-[#1d2225] px-3 text-[13px] text-[#e7ebed]\" data-kid=\"1-2-1-1-1-2-3-2-2\" data-name=\"UTM zone input display\">\n                                    Automático\n                                    <i class=\"ph ph-caret-down ml-auto text-[#99a3a8]\" data-kid=\"1-2-1-1-1-2-3-2-2-1\" data-name=\"dropdown icon\">\n                                    </i>\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"flex h-8 items-center gap-2 text-[12px] text-[#c2c9cd]\" data-kid=\"1-2-1-1-1-2-4\" data-name=\"advanced settings toggle\">\n                            <span class=\"h-4 w-4 rounded border border-[#5a6469]\" data-kid=\"1-2-1-1-1-2-4-1\" data-name=\"toggle checkbox\">\n                            </span>\n                            Campos avançados\n                            <i class=\"ph ph-caret-down text-[#899398]\" data-kid=\"1-2-1-1-1-2-4-2\" data-name=\"dropdown icon\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"my-4 h-px bg-white/10\" data-kid=\"1-2-1-1-1-3\" data-name=\"divider line\">\n                    </div>\n                    <section class=\"border-b border-[#2b3135] pb-4\" data-kid=\"1-2-1-1-1-4\" data-name=\"input file section\">\n                        <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-2-1-1-1-4-1\" data-name=\"input file header\">\n                            <h2 class=\"text-[14px] font-semibold text-[#e9edef]\" data-kid=\"1-2-1-1-1-4-1-1\" data-name=\"input file title\">\n                                Arquivo de entrada\n                                <span class=\"font-normal text-[#d79851]\" data-kid=\"1-2-1-1-1-4-1-1-1\" data-name=\"required field asterisk\">\n                                    *\n                                </span>\n                            </h2>\n                            <span class=\"text-[11px] text-[#d4a064]\" data-kid=\"1-2-1-1-1-4-1-2\" data-name=\"file status text\">\n                                Pendente\n                            </span>\n                        </div>\n                        <button class=\"flex h-9 w-full items-center justify-center gap-2 rounded-md border border-[#4a5358] bg-[#202629] text-[13px] font-medium text-[#e4e8ea]\" data-kid=\"1-2-1-1-1-4-2\" data-name=\"select KML file button\">\n                            <i class=\"ph ph-folder-open text-[16px]\" data-kid=\"1-2-1-1-1-4-2-1\" data-name=\"folder open icon\">\n                            </i>\n                            Selecionar KML/KMZ\n                        </button>\n                        <div class=\"mt-2 flex items-center gap-2 text-[12px] text-[#aab3b8]\" data-kid=\"1-2-1-1-1-4-3\" data-name=\"file selection status message\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#d79851]\" data-kid=\"1-2-1-1-1-4-3-1\" data-name=\"status indicator dot\">\n                            </span>\n                            Nenhum arquivo selecionado\n                        </div>\n                        <p class=\"mt-2 text-[12px] leading-[1.5] text-[#99a3a8]\" data-kid=\"1-2-1-1-1-4-4\" data-name=\"input file hint text\">\n                            Município, zona e área serão detectados após carregar o KML.\n                        </p>\n                    </section>\n                    <section class=\"border-b border-[#2b3135] py-4\" data-kid=\"1-2-1-1-1-5\" data-name=\"target folder section\">\n                        <h2 class=\"mb-2 text-[14px] font-semibold text-[#e9edef]\" data-kid=\"1-2-1-1-1-5-1\" data-name=\"target folder title\">\n                            Pasta de destino\n                            <span class=\"font-normal text-[#d79851]\" data-kid=\"1-2-1-1-1-5-1-1\" data-name=\"required field asterisk\">\n                                *\n                            </span>\n                        </h2>\n                        <div class=\"flex gap-2\" data-kid=\"1-2-1-1-1-5-2\" data-name=\"target folder input group\">\n                            <div class=\"flex h-9 min-w-0 flex-1 items-center truncate rounded-md border border-[#3a4145] bg-[#1d2225] px-3 text-[12px] text-[#798287]\" data-kid=\"1-2-1-1-1-5-2-1\" data-name=\"target folder display path\">\n                                Selecione a pasta para salvar\n                            </div>\n                            <button aria-label=\"Selecionar pasta de destino\" class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-[#414a4f] bg-[#202629] text-[#c3cbd0]\" data-kid=\"1-2-1-1-1-5-2-2\" data-name=\"select folder button\">\n                                <i class=\"ph ph-folder\" data-kid=\"1-2-1-1-1-5-2-2-1\" data-name=\"folder icon\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"mt-2 flex items-center gap-4 text-[12px]\" data-kid=\"1-2-1-1-1-5-3\" data-name=\"folder actions\">\n                            <button class=\"flex items-center gap-1.5 text-[#aeb7bc]\" data-kid=\"1-2-1-1-1-5-3-1\" data-name=\"open folder button\">\n                                <i class=\"ph ph-folder-open\" data-kid=\"1-2-1-1-1-5-3-1-1\" data-name=\"folder open icon\">\n                                </i>\n                                Abrir pasta\n                            </button>\n                            <button class=\"flex items-center gap-1.5 text-[#aeb7bc]\" data-kid=\"1-2-1-1-1-5-3-2\" data-name=\"copy path button\">\n                                <i class=\"ph ph-copy\" data-kid=\"1-2-1-1-1-5-3-2-1\" data-name=\"copy icon\">\n                                </i>\n                                Copiar caminho\n                            </button>\n                        </div>\n                        <p class=\"mt-2 text-[12px] leading-[1.45] text-[#99a3a8]\" data-kid=\"1-2-1-1-1-5-4\" data-name=\"target folder hint text\">\n                            O GeoPackage será copiado para BASES. A origem da rede não será alterada.\n                        </p>\n                    </section>\n                    <section class=\"pt-4\" data-kid=\"1-2-1-1-1-6\" data-name=\"pending tasks section\">\n                        <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-2-1-1-1-6-1\" data-name=\"pending tasks header\">\n                            <h2 class=\"text-[14px] font-semibold text-[#e9edef]\" data-kid=\"1-2-1-1-1-6-1-1\" data-name=\"pending tasks title\">\n                                Pendências para gerar\n                            </h2>\n                            <span class=\"text-[12px] text-[#aab3b8]\" data-kid=\"1-2-1-1-1-6-1-2\" data-name=\"pending tasks count\">\n                                3 obrigatórias\n                            </span>\n                        </div>\n                        <ul class=\"space-y-2 text-[12px] leading-[1.45] text-[#c7cdd0]\" data-kid=\"1-2-1-1-1-6-2\" data-name=\"pending tasks list\">\n                            <li class=\"flex items-start gap-2\" data-kid=\"1-2-1-1-1-6-2-1\" data-name=\"pending task item 1\">\n                                <span class=\"mt-[5px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#d79851]\" data-kid=\"1-2-1-1-1-6-2-1-1\" data-name=\"pending status dot\">\n                                </span>\n                                Informe o nome da obra\n                            </li>\n                            <li class=\"flex items-start gap-2\" data-kid=\"1-2-1-1-1-6-2-2\" data-name=\"pending task item 2\">\n                                <span class=\"mt-[5px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#d79851]\" data-kid=\"1-2-1-1-1-6-2-2-1\" data-name=\"pending status dot\">\n                                </span>\n                                Carregue um arquivo KML/KMZ\n                            </li>\n                            <li class=\"flex items-start gap-2\" data-kid=\"1-2-1-1-1-6-2-3\" data-name=\"pending task item 3\">\n                                <span class=\"mt-[5px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#d79851]\" data-kid=\"1-2-1-1-1-6-2-3-1\" data-name=\"pending status dot\">\n                                </span>\n                                Selecione uma pasta de destino\n                            </li>\n                        </ul>\n                        <button class=\"mt-3 flex items-center gap-1.5 text-[12px] text-[#9da7ac]\" data-kid=\"1-2-1-1-1-6-3\" data-name=\"log system view button\">\n                            <i class=\"ph ph-terminal-window\" data-kid=\"1-2-1-1-1-6-3-1\" data-name=\"terminal icon\">\n                            </i>\n                            Ver log do sistema\n                            <i class=\"ph ph-caret-down ml-1\" data-kid=\"1-2-1-1-1-6-3-2\" data-name=\"dropdown icon\">\n                            </i>\n                        </button>\n                    </section>\n                </section>\n            </div>\n        </aside>\n        <section class=\"flex min-w-0 flex-1 flex-col bg-[#111417]\" data-kid=\"1-2-2\" data-name=\"map view area\">\n            <div class=\"flex h-[54px] shrink-0 items-center justify-between px-6\" data-kid=\"1-2-2-1\" data-name=\"map toolbar\">\n                <div class=\"flex items-baseline gap-3\" data-kid=\"1-2-2-1-1\" data-name=\"map title group\">\n                    <h2 class=\"text-[15px] font-semibold text-[#eff2f3]\" data-kid=\"1-2-2-1-1-1\" data-name=\"map title text\">\n                        Mapa\n                    </h2>\n                    <span class=\"text-[12px] text-[#909ba1]\" data-kid=\"1-2-2-1-1-2\" data-name=\"map description text\">\n                        Visualização do empreendimento\n                    </span>\n                </div>\n                <button class=\"flex h-8 items-center gap-2 rounded-md border border-[#343b3f] bg-[#191e21] px-3 text-[12px] text-[#d7dcdf]\" data-kid=\"1-2-2-1-2\" data-name=\"layer selection button\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#4c91df]\" data-kid=\"1-2-2-1-2-1\" data-name=\"layer status dot\">\n                    </span>\n                    Satélite\n                    <i class=\"ph ph-caret-down ml-1 text-[#9da7ac]\" data-kid=\"1-2-2-1-2-2\" data-name=\"dropdown icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"map-image frame-shadow relative mx-5 h-[380px] shrink-0 overflow-hidden rounded-2xl border border-white bg-[#20282b]\" data-dynamic=\"true\" data-kid=\"1-2-2-2\" data-name=\"map visualization container\" data-reason=\"background position and size updated dynamically to display map view\">\n                <div class=\"absolute inset-0 bg-gradient-to-b from-[#101619]/10 via-transparent to-[#101619]/30\" data-kid=\"1-2-2-2-1\" data-name=\"gradient overlay\">\n                </div>\n                <div class=\"fle