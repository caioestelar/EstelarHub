      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"m-0 flex min-h-screen w-full flex-col bg-[#101214] font-['IBM_Plex_Sans',sans-serif] text-[#e8eaed] antialiased\" data-kid=\"1\" data-name=\"main page container\">\n    <header class=\"flex h-[58px] shrink-0 items-center justify-between border-b border-[#292d31] bg-[#151719] px-7\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"application branding container\">\n            <img alt=\"Logotipo EstelarMapTools\" class=\"h-9 w-9 shrink-0 rounded-lg object-contain\" data-kid=\"1-1-1-1\" data-name=\"EstelarMapTools logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/logo.png\"/>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\" data-name=\"application name and description container\">\n                <div class=\"truncate text-[15px] font-semibold tracking-[-0.01em] text-[#f4f5f6]\" data-kid=\"1-1-1-2-1\" data-name=\"application name text\">\n                    EstelarMapTools\n                </div>\n                <div class=\"text-[12px] text-[#92979d]\" data-kid=\"1-1-1-2-2\" data-name=\"application subtitle text\">\n                    Mapa de localização · QGIS\n                </div>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-2\" data-kid=\"1-1-2\" data-name=\"window control buttons container\">\n            <button aria-label=\"Minimizar janela\" class=\"flex h-8 w-8 items-center justify-center rounded-md text-[#9ca2a9] hover:bg-[#23272b]\" data-kid=\"1-1-2-1\" data-name=\"minimize window button\">\n                <span class=\"text-[19px] leading-none\" data-kid=\"1-1-2-1-1\" data-name=\"minus icon\">\n                    −\n                </span>\n            </button>\n            <button aria-label=\"Fechar janela\" class=\"flex h-8 w-8 items-center justify-center rounded-md text-[#9ca2a9] hover:bg-[#3a2223]\" data-kid=\"1-1-2-2\" data-name=\"close window button\">\n                <span class=\"text-[20px] leading-none\" data-kid=\"1-1-2-2-1\" data-name=\"close icon\">\n                    ×\n                </span>\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto flex w-full max-w-[1600px] flex-1 flex-col\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-label=\"Preparação do projeto\" class=\"border-b border-[#292d31] bg-[#141719] px-7 py-4\" data-kid=\"1-2-1\" data-name=\"project preparation section\">\n            <div class=\"grid grid-cols-[minmax(220px,1.25fr)_minmax(180px,.9fr)_minmax(150px,.65fr)_minmax(270px,1.2fr)] gap-x-5\" data-kid=\"1-2-1-1\" data-name=\"project configuration grid\">\n                <label class=\"min-w-0\" data-kid=\"1-2-1-1-1\" data-name=\"project name label\">\n                    <span class=\"mb-1.5 block text-[13px] font-medium text-[#b4bac1]\" data-kid=\"1-2-1-1-1-1\" data-name=\"project name label text\">\n                        Nome da obra\n                    </span>\n                    <div class=\"flex h-10 items-center rounded-md border border-[#373c41] bg-[#1c2023] px-3 text-[14px] text-[#f0f1f2]\" data-kid=\"1-2-1-1-1-2\" data-name=\"project name input display\">\n                        Parque Solar Atacama\n                        <i class=\"ti ti-chevron-down ml-auto text-[14px] text-[#848b92]\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"chevron down icon\">\n                        </i>\n                    </div>\n                </label>\n                <label class=\"min-w-0\" data-kid=\"1-2-1-1-2\" data-name=\"project type label\">\n                    <span class=\"mb-1.5 block text-[13px] font-medium text-[#b4bac1]\" data-kid=\"1-2-1-1-2-1\" data-name=\"project type label text\">\n                        Perfil rápido / tipo\n                    </span>\n                    <div class=\"flex h-10 items-center rounded-md border border-[#373c41] bg-[#1c2023] px-3 text-[14px] text-[#f0f1f2]\" data-kid=\"1-2-1-1-2-2\" data-name=\"project type input display\">\n                        UFV · Usina fotovoltaica\n                        <i class=\"ti ti-chevron-down ml-auto text-[14px] text-[#848b92]\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"chevron down icon\">\n                        </i>\n                    </div>\n                </label>\n                <label class=\"min-w-0\" data-kid=\"1-2-1-1-3\" data-name=\"UTM zone label\">\n                    <span class=\"mb-1.5 block text-[13px] font-medium text-[#b4bac1]\" data-kid=\"1-2-1-1-3-1\" data-name=\"UTM zone label text\">\n                        Zona UTM\n                    </span>\n                    <div class=\"flex h-10 items-center rounded-md border border-[#373c41] bg-[#1c2023] px-3 font-['IBM_Plex_Mono',monospace] text-[13px] text-[#f0f1f2]\" data-kid=\"1-2-1-1-3-2\" data-name=\"UTM zone input display\">\n                        19S\n                        <i class=\"ti ti-chevron-down ml-auto font-sans text-[14px] text-[#848b92]\" data-kid=\"1-2-1-1-3-2-1\" data-name=\"chevron down icon\">\n                        </i>\n                    </div>\n                </label>\n                <div class=\"flex min-w-0 items-end\" data-kid=\"1-2-1-1-4\" data-name=\"advanced configuration button container\">\n                    <button class=\"flex h-10 w-full items-center justify-between rounded-md border border-[#343a40] bg-[#1a1e21] px-3 text-left text-[13px] text-[#c7cbd0]\" data-kid=\"1-2-1-1-4-1\" data-name=\"advanced settings dropdown button\">\n                        Configurações avançadas\n                        <i class=\"ti ti-chevron-down text-[15px] text-[#899199]\" data-kid=\"1-2-1-1-4-1-1\" data-name=\"chevron down icon\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"mt-3.5 grid grid-cols-[minmax(260px,1fr)_minmax(300px,1.2fr)_minmax(250px,.9fr)] items-end gap-x-5\" data-kid=\"1-2-1-2\" data-name=\"project files configuration grid\">\n                <div class=\"min-w-0\" data-kid=\"1-2-1-2-1\" data-name=\"KML/KMZ file selection container\">\n                    <div class=\"mb-1.5 text-[13px] font-medium text-[#b4bac1]\" data-kid=\"1-2-1-2-1-1\" data-name=\"KML/KMZ file label text\">\n                        Arquivo KML/KMZ\n                    </div>\n                    <div class=\"flex h-10 min-w-0 items-center gap-2 rounded-md border border-[#3a3f44] bg-[#1b1f22] px-3\" data-kid=\"1-2-1-2-1-2\" data-name=\"KML/KMZ input display\">\n                        <i class=\"ti ti-map-pin text-[16px] text-[#a3aab1]\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"map pin icon\">\n                        </i>\n                        <span class=\"min-w-0 flex-1 truncate text-[13px] text-[#aeb4bb]\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"file selection status text\">\n                            Nenhum arquivo selecionado\n                        </span>\n                        <button class=\"inline-flex h-8 shrink-0 items-center gap-1.5 rounded-md border border-[#41474f] bg-[#252a2f] px-2.5 text-[12px] font-medium text-[#e3e6e9]\" data-kid=\"1-2-1-2-1-2-3\" data-name=\"import button\">\n                            <i class=\"ti ti-upload text-[14px]\" data-kid=\"1-2-1-2-1-2-3-1\" data-name=\"upload icon\">\n                            </i>\n                            Importar\n                        </button>\n                    </div>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-2-1-2-2\" data-name=\"destination folder selection container\">\n                    <div class=\"mb-1.5 text-[13px] font-medium text-[#b4bac1]\" data-kid=\"1-2-1-2-2-1\" data-name=\"destination folder label te