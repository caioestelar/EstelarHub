    },
    "var_2ee98a58d9e8": {
      "type": "variant",
      "label": "03 — Project dossier review",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n</style>\n<div class=\"m-0 flex h-[960px] w-full flex-col overflow-hidden bg-[#111417] font-[IBM_Plex_Sans,Arial,sans-serif] text-[#eff2f3] antialiased\" data-kid=\"1\">\n    <header class=\"flex h-[62px] shrink-0 items-center justify-between border-b border-[#30363a] bg-[#171b1e] px-5\" data-kid=\"1-1\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\">\n            <img alt=\"Estelar MapTools\" class=\"h-[38px] w-[38px] shrink-0 object-contain\" data-kid=\"1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/ui/assets/logo.png\"/>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\">\n                <div class=\"truncate text-[15px] font-semibold tracking-[-0.02em] text-[#f4f5f6]\" data-kid=\"1-1-1-2-1\">\n                    EstelarMapTools\n                </div>\n                <div class=\"text-[11px] text-[#9ca6ac]\" data-kid=\"1-1-1-2-2\">\n                    Projeto de mapa de localização\n                </div>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-1 text-[15px] text-[#a9b1b6]\" data-kid=\"1-1-2\">\n            <button aria-label=\"Minimizar janela\" class=\"flex h-8 w-8 items-center justify-center rounded-md hover:bg-[#272c30]\" data-kid=\"1-1-2-1\">\n                <i class=\"ph ph-minus\" data-kid=\"1-1-2-1-1\">\n                </i>\n            </button>\n            <button aria-label=\"Fechar janela\" class=\"flex h-8 w-8 items-center justify-center rounded-md hover:bg-[#272c30]\" data-kid=\"1-1-2-2\">\n                <i class=\"ph ph-x\" data-kid=\"1-1-2-2-1\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"flex min-h-0 flex-1\" data-kid=\"1-2\">\n        <aside class=\"flex w-[344px] shrink-0 flex-col border-r border-[#30363a] bg-[#15191c]\" data-kid=\"1-2-1\">\n            <div class=\"min-h-0 flex-1 overflow-y-auto px-5 pb-4 pt-5\" data-kid=\"1-2-1-1\">\n                <h1 class=\"mb-4 text-[18px] font-semibold tracking-[-0.025em] text-[#f4f5f6]\" data-kid=\"1-2-1-1-1\">\n                    Configuração do projeto\n                </h1>\n                <section class=\"border-b border-[#2b3135] pb-4\" data-kid=\"1-2-1-1-2\">\n                    <label class=\"mb-1.5 block text-[12px] font-medium text-[#c2c9cd]\" data-kid=\"1-2-1-1-2-1\">\n                        Nome da obra\n                        <span class=\"text-[#d79851]\" data-kid=\"1-2-1-1-2-1-1\">\n                            *\n                        </span>\n                    </label>\n                    <div class=\"flex h-9 items-center rounded-md border border-[#3a4145] bg-[#1d2225] px-3 text-[13px] text-[#798287]\" data-kid=\"1-2-1-1-2-2\">\n                        <span class=\"flex-1\" data-kid=\"1-2-1-1-2-2-1\">\n                            Selecione ou digite a obra\n                        </span>\n                        <i class=\"ph ph-caret-down text-[13px]\" data-kid=\"1-2-1-1-2-2-2\">\n                        </i>\n                    </div>\n                    <div class=\"mt-3\" data-kid=\"1-2-1-1-2-3\">\n                        <label class=\"mb-1.5 block text-[12px] font-medium text-[#c2c9cd]\" data-kid=\"1-2-1-1-2-3-1\">\n                            Perfil rápido\n                        </label>\n                        <div class=\"flex h-9 items-center rounded-md border border-[#3a4145] bg-[#1d2225] px-3 text-[13px] text-[#e7ebed]\" data-kid=\"1-2-1-1-2-3-2\">\n                            <span class=\"flex-1\" data-kid=\"1-2-1-1-2-3-2-1\">\n                                Padrão\n                            </span>\n                            <i class=\"ph ph-caret-down text-[#99a3a8]\" data-kid=\"1-2-1-1-2-3-2-2\">\n                            </i>\n                        </div>\n                    </div>\n                    <div class=\"mt-3 grid grid-cols-2 gap-3\" data-kid=\"1-2-1-1-2-4\">\n                        <div data-kid=\"1-2-1-1-2-4-1\">\n                            <label class=\"mb-1.5 block text-[12px] font-medium text-[#c2c9cd]\" data-kid=\"1-2-1-1-2-4-1-1\">\n                                Tipo de projeto\n                            </label>\n                            <div class=\"flex h-9 items-center rounded-md border border-[#3a4145] bg-[#1d2225] px-3 text-[13px] text-[#e7ebed]\" data-kid=\"1-2-1-1-2-4-1-2\">\n                                <span class=\"flex-1\" data-kid=\"1-2-1-1-2-4-1-2-1\">\n                                    PCH\n                                </span>\n                                <i class=\"ph ph-caret-down text-[#99a3a8]\" data-kid=\"1-2-1-1-2-4-1-2-2\">\n                                </i>\n                            </div>\n                        </div>\n                        <div data-kid=\"1-2-1-1-2-4-2\">\n                            <label class=\"mb-1.5 block text-[12px] font-medium text-[#c2c9cd]\" data-kid=\"1-2-1-1-2-4-2-1\">\n                                Zona UTM\n                            </label>\n                            <div class=\"flex h-9 items-center rounded-md border border-[#3a4145] bg-[#1d2225] px-3 text-[13px] text-[#e7ebed]\" data-kid=\"1-2-1-1-2-4-2-2\">\n                                <span class=\"flex-1\" data-kid=\"1-2-1-1-2-4-2-2-1\">\n                                    Automático\n                                </span>\n                                <i class=\"ph ph-caret-down text-[#99a3a8]\" data-kid=\"1-2-1-1-2-4-2-2-2\">\n                                </i>\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"mt-3 flex h-8 items-center gap-2 text-[12px] text-[#c2c9cd]\" data-kid=\"1-2-1-1-2-5\">\n                        <span class=\"h-4 w-4 rounded border border-[#5a6469]\" data-kid=\"1-2-1-1-2-5-1\">\n                        </span>\n                        Campos avançados\n                        <i class=\"ph ph-caret-down ml-1 text-[#899398]\" data-kid=\"1-2-1-1-2-5-2\">\n                        </i>\n                    </button>\n                </section>\n                <section class=\"border-b border-[#2b3135] py-4\" data-kid=\"1-2-1-1-3\">\n                    <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-2-1-1-3-1\">\n                        <h2 class=\"text-[14px] font-semibold text-[#e9edef]\" data-kid=\"1-2-1-1-3-1-1\">\n                            Arquivo de entrada\n                            <span class=\"font-normal text-[#d79851]\" data-kid=\"1-2-1-1-3-1-1-1\">\n                                *\n                            </span>\n                        </h2>\n                        <span class=\"text-[11px] text-[#d4a064]\" data-kid=\"1-2-1-1-3-1-2\">\n                            Pendente\n                        </span>\n                    </div>\n                    <button class=\"flex h-9 w-full items-center justify-center gap-2 rounded-md border border-[#4a5358] bg-[#202629] text-[13px] font-medium text-[#e4e8ea] hover:bg-[#282f33]\" data-kid=\"1-2-1-1-3-2\">\n                        <i class=\"ph ph-folder-open text-[16px]\" data-kid=\"1-2-1-1-3-2-1\">\n                        </i>\n                        Selecionar KML/KMZ\n                    </button>\n                    <div class=\"mt-2 flex items-center gap-2 text-[12px] text-[#aab3b8]\" data-kid=\"1-2-1-1-3-3\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#d79851]\" data-kid=\"1-2-1-1-3-3-1\">\n                        </span>\n                        Nenhum arquivo selecionado\n                    </div>\n                    <p class=\"mt-2 text-[12px] leading-[1.5] text-[#99a3a8]\" data-kid=\"1-2-1-1-3-4\">\n                        Município, zona e área serão detectados após carregar o KML.\n                    </p>\n                </section>\n                <section class=\"border-b border-[#2b3135] py-4\" data-kid=\"1-2-1-1-4\">\n                    <h2 class=\"mb-2 text-[14px] font-semibold text-[#e9edef]\" data-kid=\"1-2-1-1-4-1\">\n                        Pasta de destino\n                        <span class=\"font-normal text-[#d79851]\" data-kid=\"1-2-1-1-4-1-1\">\n                            *\n                        </span>\n                    </h2>\n                    <div class=\"flex gap-2\" data-kid=\"1-2-1-1-4-2\">\n                        <div class=\"flex h-9 min-w-0 flex-1 items-center rounded-md border border-[#3a4145] bg-[#1d2225] px-3 text-[12px] text-[#798287]\" data-kid=\"1-2-1-1-4-2-1\">\n                            Selecione a pasta para salvar\n                        </div>\n                        <button aria-label=\"Selecionar pasta de destino\" class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-[#414a4f] bg-[#202629] text-[#c3cbd0]\" data-kid=\"1-2-1-1-4-2-2\">\n                            <i class=\"ph ph-folder text-[16px]\" data-kid=\"1-2-1-1-4-2-2-1\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"mt-2 flex items-center gap-4 text-[12px]\" data-kid=\"1-2-1-1-4-3\">\n                        <button class=\"flex items-center gap-1.5 text-[#aeb7bc]\" data-kid=\"1-2-1-1-4-3-1\">\n                            <i class=\"ph ph-folder-open\" data-kid=\"1-2-1-1-4-3-1-1\">\n                            </i>\n                            Abrir pasta\n                        </button>\n                        <button class=\"flex items-center gap-1.5 text-[#aeb7bc]\" data-kid=\"1-2-1-1-4-3-2\">\n                            <i class=\"ph ph-copy\" data-kid=\"1-2-1-1-4-3-2-1\">\n                            </i>\n                            Copiar caminho\n                        </button>\n                    </div>\n                    <p class=\"mt-2 text-[12px] leading-[1.45] text-[#99a3a8]\" data-kid=\"1-2-1-1-4-4\">\n                        O GeoPackage será copiado para BASES. A origem da rede não será alterada.\n                    </p>\n                </section>\n                <section class=\"py-4\" data-kid=\"1-2-1-1-5\">\n                    <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-2-1-1-5-1\">\n                        <h2 class=\"text-[14px] font-semibold text-[#e9edef]\" data-kid=\"1-2-1-1-5-1-1\">\n                            Pendências para gerar\n                        </h2>\n                        <span class=\"text-[12px] text-[#aab3b8]\" data-kid=\"1-2-1-1-5-1-2\">\n                            3 obrigatórias\n                        </span>\n                    </div>\n                    <ul class=\"space-y-2 text-[12px] leading-[1.45] text-[#c7cdd0]\" data-kid=\"1-2-1-1-5-2\">\n                        <li class=\"flex items-start gap-2\" data-kid=\"1-2-1-1-5-2-1\">\n                            <span class=\"mt-[5px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#d79851]\" data-kid=\"1-2-1-1-5-2-1-1\">\n                            </span>\n                            <span data-kid=\"1-2-1-1-5-2-1-2\">\n                                Informe o nome da obra\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-2\" data-kid=\"1-2-1-1-5-2-2\">\n                            <span class=\"mt-[5px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#d79851]\" data-kid=\"1-2-1-1-5-2-2-1\">\n                            </span>\n                            <span data-kid=\"1-2-1-1-5-2-2-2\">\n                                Carregue um arquivo KML/KMZ\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-2\" data-kid=\"1-2-1-1-5-2-3\">\n                            <span class=\"mt-[5px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#d79851]\" data-kid=\"1-2-1-1-5-2-3-1\">\n                            </span>\n                            <span data-kid=\"1-2-1-1-5-2-3-2\">\n                                Selecione uma pasta de destino\n                            </span>\n                        </li>\n                    </ul>\n                    <button class=\"mt-3 flex items-center gap-1.5 text-[12px] text-[#9da7ac]\" data-kid=\"1-2-1-1-5-3\">\n                        <i class=\"ph ph-terminal-window\" data-kid=\"1-2-1-1-5-3-1\">\n                        </i>\n                        Ver log do sistema\n                        <i class=\"ph ph-caret-down ml-1\" data-kid=\"1-2-1-1-5-3-2\">\n                        </i>\n                    </button>\n                </section>\n            </div>\n        </aside>\n        <section class=\"flex min-w-0 flex-1 flex-col bg-[#111417]\" data-kid=\"1-2-2\">\n            <div class=\"flex h-[54px] shrink-0 items-center justify-between px-6\" data-kid=\"1-2-2-1\">\n                <div class=\"flex items-baseline gap-3\" data-kid=\"1-2-2-1-1\">\n                    <h2 class=\"text-[15px] font-semibold text-[#eff2f3]\" data-kid=\"1-2-2-1-1-1\">\n                        Mapa\n                    </h2>\n                    <span class=\"text-[12px] text-[#909ba1]\" data-kid=\"1-2-2-1-1-2\">\n                        Visualização do empreendimento\n                    </span>\n                </div>\n                <button class=\"flex h-8 items-center gap-2 rounded-md border border-[#343b3f] bg-[#191e21] px-3 text-[12px] text-[#d7dcdf]\" data-kid=\"1-2-2-1-2\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#4c91df]\" data-kid=\"1-2-2-1-2-1\">\n                    </span>\n                    Satélite\n                    <i class=\"ph ph-caret-down ml-1 text-[#9da7ac]\" data-kid=\"1-2-2-1-2-2\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"mx-5 overflow-hidden rounded-lg border border-[#353c40] bg-[#20282b]\" data-dynamic=\"true\" data-kid=\"1-2-2-2\" data-name=\"map canvas container\" data-reason=\"background position and style reinitialized by user map interaction\" style=\"height:410px;background-image:url('/api/local/images/.kombai/canvas/assets/estelar-original-workspace.png');background-size:3460px auto;background-position:-820px -714px;background-repeat:no-repeat;\">\n                <div class=\"flex h-full items-end p-4\" data-kid=\"1-2-2-2-1\">\n                    <div class=\"max-w-[390px] rounded-md border border-[#7e8a90]/50 bg-[#161c20]/90 px-3 py-2 text-[12px] leading-[1.5] text-[#dce2e5]\" data-kid=\"1-2-2-2-1-1\">\n                        Nenhum KML carregado. Selecione um arquivo na coluna de configuração para visualizar a geometria.\n                    </div>\n                </div>\n            </div>\n            <div class=\"mx-5 mt-4 rounded-lg border border-[#30383c] bg-[#171c1f]\" data-kid=\"1-2-2-3\">\n                <div class=\"flex items-center justify-between border-b border-[#2e363a] px-4 py-2.5\" data-kid=\"1-2-2-3-1\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-3-1-1\">\n                        <h3 class=\"text-[14px] font-semibold text-[#e9edef]\" data-kid=\"1-2-2-3-1-1-1\">\n                            Escalas dos layouts\n                        </h3>\n                        <span class=\"text-[12px] text-[#96a0a5]\" data-kid=\"1-2-2-3-1-1-2\">\n                            Ajuste as extensões mostradas no mapa\n                        </span>\n                    </div>\n                    <span class=\"text-[11px] text-[#a1aaae]\" data-kid=\"1-2-2-3-1-2\">\n                        Arrastar no mapa move os centros livres\n                    </span>\n                </div>\n                <div class=\"px-4\" data-kid=\"1-2-2-3-2\">\n                    <div class=\"grid grid-cols-[220px_minmax(150px,1fr)_150px_78px] items-center gap-4 border-b border-[#2a3135] py-3\" data-kid=\"1-2-2-3-2-1\">\n                        <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-2-3-2-1-1\">\n                            <span class=\"h-2.5 w-2.5 rounded-full bg-[#ec008b]\" data-kid=\"1-2-2-3-2-1-1-1\">\n                            </span>\n                            <div data-kid=\"1-2-2-3-2-1-1-2\">\n                                <div class=\"text-[13px] font-semibold text-[#edf0f2]\" data-kid=\"1-2-2-3-2-1-1-2-1\">\n                                    Layout 1\n                                </div>\n                                <div class=\"text-[11px] text-[#a2adb2]\" data-kid=\"1-2-2-3-2-1-1-2-2\">\n                                    Área de estudo do recorte\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"relative h-1 rounded-full bg-[#343b40]\" data-kid=\"1-2-2-3-2-1-2\">\n                            <div class=\"absolute left-0 top-0 h-1 w-[42%] rounded-full bg-[#ec008b]\" data-kid=\"1-2-2-3-2-1-2-1\">\n                            </div>\n                            <span class=\"absolute left-[42%] top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-[#171c1f] bg-[#ec008b]\" data-kid=\"1-2-2-3-2-1-2-2\">\n                            </span>\n                        </div>\n                        <div class=\"text-right text-[13px] font-semibold tabular-nums text-[#f0c1dc]\" data-kid=\"1-2-2-3-2-1-3\">\n                            1:500.000\n                        </div>\n                        <button aria-label=\"Travar centro do Layout 1\" class=\"flex h-8 items-center justify-center gap-1 rounded border border-[#424b50] text-[11px] text-[#d2d8db]\" data-kid=\"1-2-2-3-2-1-4\">\n                            <i class=\"ph ph-lock-open text-[14px]\" data-kid=\"1-2-2-3-2-1-4-1\">\n                            </i>\n                            Travar\n                        </button>\n                    </div>\n                    <div class=\"grid grid-cols-[220px_minmax(150px,1fr)_150px_78px] items-center gap-4 border-b border-[#2a3135] py-3\" data-kid=\"1-2-2-3-2-2\">\n                        <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-2-3-2-2-1\">\n                            <span class=\"h-2.5 w-2.5 rounded-full bg-[#f79138]\" data-kid=\"1-2-2-3-2-2-1-1\">\n                            </span>\n                            <div class=\"text-[13px] font-semibold text-[#edf0f2]\" data-kid=\"1-2-2-3-2-2-1-2\">\n                                Layout 2\n                            </div>\n                        </div>\n                        <div class=\"relative h-1 rounded-full bg-[#343b40]\" data-kid=\"1-2-2-3-2-2-2\">\n                            <div class=\"absolute left-0 top-0 h-1 w-[9%] rounded-full bg-[#f79138]\" data-kid=\"1-2-2-3-2-2-2-1\">\n                            </div>\n                            <span class=\"absolute left-[9%] top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-[#171c1f] bg-[#f79138]\" data-kid=\"1-2-2-3-2-2-2-2\">\n                            </span>\n                        </div>\n                        <div class=\"text-right text-[13px] font-semibold tabular-nums text-[#f0c49e]\" data-kid=\"1-2-2-3-2-2-3\">\n                            1:100.000\n                        </div>\n                        <button aria-label=\"Travar centro do Layout 2\" class=\"flex h-8 items-center justify-center gap-1 rounded border border-[#424b50] text-[11px] text-[#d2d8db]\" data-kid=\"1-2-2-3-2-2-4\">\n                            <i class=\"ph ph-lock-open text-[14px]\" data-kid=\"1-2-2-3-2-2-4-1\">\n                            </i>\n                            Travar\n                        </button>\n                    </div>\n                    <div class=\"grid grid-cols-[220px_minmax(150px,1fr)_150px_78px] items-center gap-4 py-3\" data-kid=\"1-2-2-3-2-3\">\n                        <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-2-3-2-3-1\">\n                            <span class=\"h-2.5 w-2.5 rounded-full bg-[#00c4d2]\" data-kid=\"1-2-2-3-2-3-1-1\">\n                            </span>\n                            <div class=\"text-[13px] font-semibold text-[#edf0f2]\" data-kid=\"1-2-2-3-2-3-1-2\">\n                                Layout 3\n                            </div>\n                        </div>\n                        <div class=\"relative h-1 rounded-full bg-[#343b40]\" data-kid=\"1-2-2-3-2-3-2\">\n                            <div class=\"absolute left-0 top-0 h-1 w-[2%] rounded-full bg-[#00c4d2]\" data-kid=\"1-2-2-3-2-3-2-1\">\n                            </div>\n                            <span class=\"absolute left-[2%] top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-[#171c1f] bg-[#00c4d2]\" data-kid=\"1-2-2-3-2-3-2-2\">\n                            </span>\n                        </div>\n                        <div class=\"text-right text-[13px] font-semibold tabular-nums text-[#9ce0e3]\" data-kid=\"1-2-2-3-2-3-3\">\n                            1:25.000\n                        </div>\n                        <button aria-label=\"Travar centro do Layout 3\" class=\"flex h-8 items-center justify-center gap-1 rounded border border-[#424b50] text-[11px] text-[#d2d8db]\" data-kid=\"1-2-2-3-2-3-4\">\n                            <i class=\"ph ph-lock-open text-[14px]\" data-kid=\"1-2-2-3-2-3-4-1\">\n                            </i>\n                            Travar\n                        </button>\n                    </div>\n                    <div class=\"border-t border-[#2e363a] py-2 text-[11px] text-[#9da7ac]\" data-kid=\"1-2-2-3-2-4\">\n                        Os centros destravados acompanham o arraste do mapa.\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex-1\" data-kid=\"1-2-2-4\">\n            </div>\n        </section>\n    </main>\n    <footer class=\"flex h-[72px] shrink-0 items-center justify-between border-t border-[#30363a] bg-[#171b1e] px-6\" data-kid=\"1-3\">\n        <button class=\"flex items-center gap-2 text-[12px] text-[#a5adb1] hover:text-[#e3e7e9]\" data-kid=\"1-3-1\">\n            <i class=\"ph ph-arrow-counter-clockwise text-[15px]\" data-kid=\"1-3-1-1\">\n            </i>\n            Resetar template\n        </button>\n        <div class=\"ml-auto mr-5 text-[12px] text-[#b5bec3]\" data-kid=\"1-3-2\">\n            3 campos obrigatórios pendentes\n        </div>\n        <button aria-disabled=\"true\" class=\"flex h-10 min-w-[188px] items-center justify-center gap-2 rounded-md border border-[#38434b] bg-[#232b31] px-5 text-[13px] font-semibold text-[#8c9aa3]\" data-kid=\"1-3-3\" disabled=\"\">\n            <i class=\"ph ph-lock-simple text-[15px]\" data-kid=\"1-3-3-1\">\n            </i>\n            Gerar projeto\n        </button>\n    </footer>\n</div>\n",
