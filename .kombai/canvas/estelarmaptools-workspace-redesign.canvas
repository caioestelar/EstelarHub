xt\">\n                                Demonstração conceitual do padrão QPT — impressão não validada.\n                            </div>\n                        </article>\n                    </aside>\n                </div>\n            </section>\n        </section>\n    </main>\n    <footer class=\"flex h-[72px] shrink-0 items-center justify-between border-t border-[#30363a] bg-[#171b1e] px-6\" data-kid=\"1-3\" data-name=\"footer bar\">\n        <button class=\"flex items-center gap-2 text-[12px] text-[#a5adb1]\" data-kid=\"1-3-1\" data-name=\"reset template button\">\n            <i class=\"ph ph-arrow-counter-clockwise text-[15px]\" data-kid=\"1-3-1-1\" data-name=\"reset icon\">\n            </i>\n            Resetar template\n        </button>\n        <div class=\"ml-auto mr-5 text-[12px] text-[#b5bec3]\" data-kid=\"1-3-2\" data-name=\"pending tasks summary\">\n            3 campos obrigatórios pendentes\n        </div>\n        <button aria-disabled=\"true\" class=\"flex h-10 min-w-[188px] items-center justify-center gap-2 rounded-md border border-[#38434b] bg-[#232b31] px-5 text-[13px] font-semibold text-[#8c9aa3]\" data-kid=\"1-3-3\" data-name=\"generate project button\">\n            <i class=\"ph ph-lock-simple text-[15px]\" data-kid=\"1-3-3-1\" data-name=\"lock icon\">\n            </i>\n            Gerar projeto\n        </button>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-10-05T12:28:57.414589+00:00",
      "modified": "2026-10-05T12:37:08.953518+00:00",
      "id": "var_988d37646207"
    },
    "var_d018bf720aa6": {
      "type": "variant",
      "label": "01 — Map-led · quadro padrão",
      "parentId": "var_2e99841618f0",
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.workbench { height: 800px; min-width: 1100px; }\n.workspace { height: 652px; display: grid; grid-template-columns: 306px minmax(0,1fr) 278px; }\n.left-rail, .right-rail { overflow-y: auto; }\n.center-area { min-width: 0; display: flex; flex-direction: column; }\n.map-view { min-height: 0; flex: 1; position: relative; overflow: hidden; }\n.scale-bench { height: 294px; flex: 0 0 294px; }\n.control { height: 36px; }\n.row-track { position: relative; height: 4px; border-radius: 99px; background: #363b42; }\n.slider-thumb { position: absolute; top: 50%; width: 13px; height: 13px; border-radius: 50%; border: 2px solid #17191c; transform: translate(-50%,-50%); }\n@media(max-height:800px) { .workbench { height: 800px; } .workspace { height: 652px; } }\n</style>\n<div class=\"workbench flex w-full flex-col bg-[#101214] font-['Inter',sans-serif] text-[#e7e9ed] antialiased\" data-kid=\"1\" data-name=\"workbench application container\">\n    <header class=\"flex h-[62px] shrink-0 items-center justify-between border-b border-white/10 bg-[#151719] px-6\" data-kid=\"1-1\" data-name=\"header bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"branding container\">\n            <img alt=\"Logotipo EstelarMapTools\" class=\"h-9 w-9 object-contain\" data-kid=\"1-1-1-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/logo.png\"/>\n            <div class=\"leading-tight\" data-kid=\"1-1-1-2\" data-name=\"header title container\">\n                <div class=\"text-[15px] font-semibold tracking-[-0.02em] text-[#f2f3f5]\" data-kid=\"1-1-1-2-1\" data-name=\"app title text\">\n                    EstelarMapTools\n                </div>\n                <div class=\"mt-0.5 text-[11px] text-[#949aa2]\" data-kid=\"1-1-1-2-2\" data-name=\"project status description\">\n                    Mapa de localização · novo projeto\n                </div>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-3 text-[12px]\" data-kid=\"1-1-2\" data-name=\"header controls container\">\n            <span class=\"text-[#969ca5]\" data-kid=\"1-1-2-1\" data-name=\"project label\">\n                Projeto\n            </span>\n            <span class=\"rounded-md border border-white/10 bg-white/[0.035] px-2.5 py-1.5 text-[#b8bdc5]\" data-kid=\"1-1-2-2\" data-name=\"project status name\">\n                Ainda não selecionado\n            </span>\n            <button aria-label=\"Minimizar janela\" class=\"grid h-8 w-8 place-items-center rounded text-[#aeb4bc] hover:bg-white/[0.06]\" data-kid=\"1-1-2-3\" data-name=\"minimize window button\" title=\"Minimizar\">\n                <i class=\"ti ti-minus text-[16px]\" data-kid=\"1-1-2-3-1\" data-name=\"minimize icon\">\n                </i>\n            </button>\n            <button aria-label=\"Fechar janela\" class=\"grid h-8 w-8 place-items-center rounded text-[#aeb4bc] hover:bg-white/[0.06]\" data-kid=\"1-1-2-4\" data-name=\"close window button\" title=\"Fechar\">\n                <i class=\"ti ti-x text-[16px]\" data-kid=\"1-1-2-4-1\" data-name=\"close icon\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"workspace\" data-kid=\"1-2\" data-name=\"main workspace area\">\n        <aside class=\"left-rail bg-[#141618] px-[18px] pb-4 pt-5\" data-kid=\"1-2-1\" data-name=\"left sidebar container\">\n            <div class=\"mb-4 flex items-center justify-between\" data-kid=\"1-2-1-1\" data-name=\"sidebar header\">\n                <h1 class=\"text-[15px] font-semibold tracking-[-0.02em] text-[#f0f1f3]\" data-kid=\"1-2-1-1-1\" data-name=\"sidebar title\">\n                    Preparar projeto\n                </h1>\n            </div>\n            <div class=\"space-y-[15px]\" data-kid=\"1-2-1-2\" data-name=\"control group container\">\n                <section data-kid=\"1-2-1-2-1\" data-name=\"work name field container\">\n                    <label class=\"mb-1.5 block text-[12px] font-medium text-[#c3c7ce]\" data-kid=\"1-2-1-2-1-1\" data-name=\"work name label\">\n                        Nome da obra\n                        <span class=\"text-[#dfaa69]\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"required field asterisk\">\n                            *\n                        </span>\n                    </label>\n                    <div class=\"control flex items-center gap-2 rounded-md border border-[#3a3f45] bg-[#1a1c1f] px-3 text-[12px] text-[#858c95]\" data-kid=\"1-2-1-2-1-2\" data-name=\"search input control\">\n                        <i class=\"ti ti-search text-[15px] text-[#7d858f]\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"search icon\">\n                        </i>\n                        <span data-kid=\"1-2-1-2-1-2-2\" data-name=\"search placeholder text\">\n                            Buscar ou digitar uma obra\n                        </span>\n                    </div>\n                </section>\n                <section class=\"grid grid-cols-2 gap-x-2.5\" data-kid=\"1-2-1-2-2\" data-name=\"profile and zone controls container\">\n                    <div data-kid=\"1-2-1-2-2-1\" data-name=\"quick profile field container\">\n                        <label class=\"mb-1.5 block text-[12px] font-medium text-[#c3c7ce]\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"quick profile label\">\n                            Perfil rápido\n                        </label>\n                        <div class=\"control flex items-center justify-between rounded-md border border-[#3a3f45] bg-[#1a1c1f] px-3 text-[12px] text-[#e1e3e6]\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"quick profile dropdown control\">\n                            Padrão\n                            <i class=\"ti ti-chevron-down text-[14px] text-[#8d949c]\" data-kid=\"1-2-1-2-2-1-2-1\" data-name=\"chevron icon\">\n                            </i>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-1-2-2-2\" data-name=\"utm zone field container\">\n                        <label class=\"mb-1.5 block text-[12px] font-medium text-[#c3c7ce]\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"utm zone label\">\n                            Zona UTM\n                        </label>\n                        <div class=\"control flex items-center justify-between rounded-md border border-[#3a3f45] bg-[#1a1c1f] px-3 text-[12px] text-[#e1e3e6]\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"utm zone dropdown control\">\n                            Automático\n                            <i class=\"ti ti-chevron-down text-[14px] text-[#8d949c]\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"chevron icon\">\n                            </i>\n                        </div>\n                    </div>\n                </section>\n                <section data-kid=\"1-2-1-2-3\" data-name=\"project type field container\">\n                    <label class=\"mb-1.5 block text-[12px] font-medium text-[#c3c7ce]\" data-kid=\"1-2-1-2-3-1\" data-name=\"project type label\">\n                        Tipo de projeto\n                    </label>\n                    <div class=\"control flex items-center justify-between rounded-md border border-[#3a3f45] bg-[#1a1c1f] px-3 text-[12px] text-[#e1e3e6]\" data-kid=\"1-2-1-2-3-2\" data-name=\"project type dropdown control\">\n                        PCH\n                        <i class=\"ti ti-chevron-down text-[14px] text-[#8d949c]\" data-kid=\"1-2-1-2-3-2-1\" data-name=\"chevron icon\">\n                        </i>\n                    </div>\n                </section>\n                <button class=\"flex items-center gap-2 py-0.5 text-[12px] text-[#c3c7ce]\" data-kid=\"1-2-1-2-4\" data-name=\"advanced mode toggle button\">\n                    <span class=\"h-4 w-4 rounded border border-[#535961] bg-[#1a1c1f]\" data-kid=\"1-2-1-2-4-1\" data-name=\"checkbox icon\">\n                    </span>\n                    Modo avançado\n                </button>\n                <div class=\"h-px bg-white/[0.08]\" data-kid=\"1-2-1-2-5\" data-name=\"horizontal separator line\">\n                </div>\n                <section data-kid=\"1-2-1-2-6\" data-name=\"input file section\">\n                    <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-2-1-2-6-1\" data-name=\"input file section header\">\n                        <h2 class=\"text-[13px] font-semibold text-[#e8e9ec]\" data-kid=\"1-2-1-2-6-1-1\" data-name=\"input file title\">\n                            Arquivo de entrada\n                        </h2>\n                        <span class=\"text-[11px] text-[#a7adb5]\" data-kid=\"1-2-1-2-6-1-2\" data-name=\"input file status tag\">\n                            Obrigatório\n                        </span>\n                    </div>\n                    <div class=\"rounded-xl border border-dashed border-[#565d66] bg-[#181a1d] px-3 py-3.5\" data-kid=\"1-2-1-2-6-2\" data-name=\"file selection area\">\n                        <div class=\"flex items-start gap-2.5\" data-kid=\"1-2-1-2-6-2-1\" data-name=\"file info container\">\n                            <i class=\"ti ti-file-import mt-0.5 text-[17px] text-[#aeb5bf]\" data-kid=\"1-2-1-2-6-2-1-1\" data-name=\"file import icon\">\n                            </i>\n                            <div data-kid=\"1-2-1-2-6-2-1-2\" data-name=\"file label container\">\n                                <div class=\"text-[12px] font-medium text-[#e1e3e6]\" data-kid=\"1-2-1-2-6-2-1-2-1\" data-name=\"file status text\">\n                                    Nenhum KML/KMZ selecionado\n                                </div>\n                                <p class=\"mt-1 text-[11px] leading-[1.45] text-[#a0a6ae]\" data-kid=\"1-2-1-2-6-2-1-2-2\" data-name=\"file instructions text\">\n                                    Importe a geometria da área de estudo para carregar o mapa.\n                                </p>\n                            </div>\n                        </div>\n                        <button class=\"mt-3 flex h-8 w-full items-center justify-center gap-2 rounded border border-[#41474f] bg-[#222529] px-3 text-[12px] font-medium text-[#e8e9ec]\" data-kid=\"1-2-1-2-6-2-2\" data-name=\"select file button\">\n                            <i class=\"ti ti-folder-open text-[15px]\" data-kid=\"1-2-1-2-6-2-2-1\" data-name=\"folder open icon\">\n                            </i>\n                            Selecionar arquivo\n                        </button>\n                    </div>\n                </section>\n                <section data-kid=\"1-2-1-2-7\" data-name=\"destination folder section\">\n                    <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-2-1-2-7-1\" data-name=\"destination header\">\n                        <h2 class=\"text-[13px] font-semibold text-[#e8e9ec]\" data-kid=\"1-2-1-2-7-1-1\" data-name=\"destination title\">\n                            Pasta de destino\n                        </h2>\n                        <span class=\"text-[11px] text-[#a7adb5]\" data-kid=\"1-2-1-2-7-1-2\" data-name=\"destination status tag\">\n                            Obrigatório\n                        </span>\n                    </div>\n                    <div class=\"control flex items-center gap-2 rounded-md border border-[#3a3f45] bg-[#1a1c1f] px-2.5 text-[12px] text-[#8a9098]\" data-kid=\"1-2-1-2-7-2\" data-name=\"folder path input control\">\n                        <i class=\"ti ti-folder text-[15px]\" data-kid=\"1-2-1-2-7-2-1\" data-name=\"folder icon\">\n                        </i>\n                        <span class=\"flex-1 truncate\" data-kid=\"1-2-1-2-7-2-2\" data-name=\"selected folder path text\">\n                            Nenhuma pasta selecionada\n                        </span>\n                        <button aria-label=\"Selecionar pasta\" class=\"h-7 w-7 rounded text-[#c3c8cf]\" data-kid=\"1-2-1-2-7-2-3\" data-name=\"select folder button\">\n                            <i class=\"ti ti-folder-plus text-[16px]\" data-kid=\"1-2-1-2-7-2-3-1\" data-name=\"folder plus icon\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"mt-1.5 flex gap-4\" data-kid=\"1-2-1-2-7-3\" data-name=\"folder operations container\">\n                        <button class=\"flex items-center gap-1.5 text-[11px] text-[#777e87]\" data-kid=\"1-2-1-2-7-3-1\" data-name=\"open folder button\" disabled=\"\">\n                            <i class=\"ti ti-folder-open text-[14px]\" data-kid=\"1-2-1-2-7-3-1-1\" data-name=\"folder icon\">\n                            </i>\n                            Abrir pasta\n                        </button>\n                        <button class=\"flex items-center gap-1.5 text-[11px] text-[#777e87]\" data-kid=\"1-2-1-2-7-3-2\" data-name=\"copy path button\" disabled=\"\">\n                            <i class=\"ti ti-copy text-[14px]\" data-kid=\"1-2-1-2-7-3-2-1\" data-name=\"copy icon\">\n                            </i>\n                            Copiar caminho\n                        </button>\n                    </div>\n                    <p class=\"mt-2 text-[11px] leading-[1.45] text-[#9ba1a9]\" data-kid=\"1-2-1-2-7-4\" data-name=\"folder notice text\">\n                        O GeoPackage será copiado para\n                        <span class=\"text-[#c4c8ce]\" data-kid=\"1-2-1-2-7-4-1\" data-name=\"base name highlight\">\n                            BASES\n                        </span>\n                        ; a origem permanece intacta.\n                    </p>\n                </section>\n            </div>\n        </aside>\n        <section class=\"center-area bg-[#101214]\" data-kid=\"1-2-2\" data-name=\"center content area\">\n            <div class=\"flex h-[48px] shrink-0 items-center justify-between border-b border-white/[0.08] px-4\" data-kid=\"1-2-2-1\" data-name=\"map toolbar container\">\n                <div class=\"flex items-center gap-2 text-[12px]\" data-kid=\"1-2-2-1-1\" data-name=\"map breadcrumb container\">\n                    <i class=\"ti ti-map-2 text-[16px] text-[#aab1ba]\" data-kid=\"1-2-2-1-1-1\" data-name=\"map icon\">\n                    </i>\n                    <span class=\"font-medium text-[#e1e3e6]\" data-kid=\"1-2-2-1-1-2\" data-name=\"map view text\">\n                        Visualização do mapa\n                    </span>\n                    <span class=\"text-[#717881]\" data-kid=\"1-2-2-1-1-3\" data-name=\"separator slash\">\n                        /\n                    </span>\n                    <span class=\"text-[#9299a2]\" data-kid=\"1-2-2-1-1-4\" data-name=\"map status text\">\n                        Aguardando KML/KMZ\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-1 rounded-md border border-white/[0.09] bg-[#191b1e] p-1 text-[11px]\" data-kid=\"1-2-2-1-2\" data-name=\"map mode switcher container\">\n                    <button class=\"rounded bg-[#34383e] px-2.5 py-1.5 font-medium text-[#f0f1f3]\" data-kid=\"1-2-2-1-2-1\" data-name=\"satellite mode button\">\n                        Satélite\n                    </button>\n                    <button class=\"rounded px-2.5 py-1.5 text-[#a7adb5]\" data-kid=\"1-2-2-1-2-2\" data-name=\"map mode button\">\n                        Mapa\n                    </button>\n                    <button class=\"rounded px-2.5 py-1.5 text-[#a7adb5]\" data-kid=\"1-2-2-1-2-3\" data-name=\"no cities mode button\">\n                        Sem cidades\n                    </button>\n                </div>\n            </div>\n            <div class=\"map-view bg-[#182025]\" data-kid=\"1-2-2-2\" data-name=\"map display container\">\n                <img alt=\"Vista aérea de painéis solares em terreno árido — foto de Charl Durand, Pexels\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"1-2-2-2-1\" data-name=\"map base layer image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/6996421/pexels-photo-6996421.jpeg?auto=compress&cs=tinysrgb&w=1400&q=80\"/>\n                <div class=\"absolute inset-0 bg-[#0b1116]/[0.19]\" data-kid=\"1-2-2-2-2\" data-name=\"overlay shadow\">\n                </div>\n                <div class=\"absolute inset-0 opacity-[0.13]\" data-kid=\"1-2-2-2-3\" data-name=\"grid overlay pattern\" style=\"background-image:linear-gradient(rgba(230,235,240,.5) 1px,transparent 1px),linear-gradient(90deg,rgba(230,235,240,.5) 1px,transparent 1px);background-size:72px 72px\">\n                </div>\n                <div class=\"absolute left-4 top-4 rounded-lg border border-white/15 bg-[#14191e]/90 px-3 py-2 text-[12px] text-[#e9ebee]\" data-kid=\"1-2-2-2-4\" data-name=\"map warning notification container\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-4-1\" data-name=\"warning header\">\n                        <i class=\"ti ti-map-pin-off text-[15px] text-[#c1c5ca]\" data-kid=\"1-2-2-2-4-1-1\" data-name=\"warning icon\">\n                        </i>\n                        <span class=\"font-medium\" data-kid=\"1-2-2-2-4-1-2\" data-name=\"warning title\">\n                            Sem geometria carregada\n                        </span>\n                    </div>\n                    <div class=\"mt-1 text-[11px] text-[#b1b6bd]\" data-kid=\"1-2-2-2-4-2\" data-name=\"warning description\">\n                        Selecione um KML/KMZ para ver a área de estudo.\n                    </div>\n                </div>\n                <div class=\"absolute bottom-3 left-4 flex items-center gap-2 rounded bg-[#14191e]/85 px-2.5 py-1.5 text-[10px] text-[#d0d4d9]\" data-kid=\"1-2-2-2-5\" data-name=\"reference base tag container\">\n                    <span data-kid=\"1-2-2-2-5-1\" data-name=\"base reference text\">\n                        Base de referência\n                    </span>\n                    <span class=\"text-white/30\" data-kid=\"1-2-2-2-5-2\" data-name=\"separator dot\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-2-2-2-5-3\" data-name=\"visual reference text\">\n                        Visual ilustrativa\n                    </span>\n                </div>\n                <div class=\"absolute bottom-3 right-4 flex items-center gap-2 rounded bg-[#14191e]/85 px-2.5 py-1.5 text-[10px] tabular-nums text-[#d0d4d9]\" data-kid=\"1-2-2-2-6\" data-name=\"coordinates info container\">\n                    <span data-kid=\"1-2-2-2-6-1\" data-name=\"utm mode text\">\n                        UTM automático\n                    </span>\n                    <span class=\"text-white/30\" data-kid=\"1-2-2-2-6-2\" data-name=\"separator dot\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-3\" data-name=\"coordinates value text\">\n                        Sem coordenadas\n                    </span>\n                </div>\n                <div class=\"absolute right-4 top-4 flex flex-col overflow-hidden rounded-lg border border-white/15 bg-[#171a1e]/90\" data-kid=\"1-2-2-2-7\" data-name=\"map zoom controls container\">\n                    <button aria-label=\"Aproximar mapa\" class=\"grid h-8 w-8 place-items-center text-[17px] text-[#e0e3e6]\" data-kid=\"1-2-2-2-7-1\" data-name=\"zoom in button\">\n                        +\n                    </button>\n                    <div class=\"h-px bg-white/10\" data-kid=\"1-2-2-2-7-2\" data-name=\"separator line\">\n                    </div>\n                    <button aria-label=\"Afastar mapa\" class=\"grid h-8 w-8 place-items-center text-[17px] text-[#e0e3e6]\" data-kid=\"1-2-2-2-7-3\" data-name=\"zoom out button\">\n                        −\n                    </button>\n                </div>\n            </div>\n            <section class=\"scale-bench border-t border-white/10 bg-[#17191c] px-4 pt-3 pb-3\" data-kid=\"1-2-2-3\" data-name=\"layouts scale section\">\n                <div class=\"mb-2.5 flex items-center justify-between\" data-kid=\"1-2-2-3-1\" data-name=\"layouts header\">\n                    <div class=\"text-[12px] font-semibold text-[#e7e9ec]\" data-kid=\"1-2-2-3-1-1\" data-name=\"layouts title\">\n                        Extensões dos layouts\n                    </div>\n                    <div class=\"text-[11px] text-[#a3a9b1]\" data-kid=\"1-2-2-3-1-2\" data-name=\"layouts instructions\">\n                        Arraste no mapa para reposicionar extensões desbloqueadas\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-3 gap-3\" data-kid=\"1-2-2-3-2\" data-name=\"layouts cards container\">\n                    <article class=\"rounded-2xl border border-white bg-[#1b1d20] p-4 shadow-[0_10px_24px_rgba(0,0,0,0.15)]\" data-kid=\"1-2-2-3-2-1\" data-name=\"layout 1 card\">\n                        <div class=\"flex h-[21px] items-center gap-2\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"layout 1 header\">\n                            <span class=\"h-2.5 w-2.5 shrink-0 rounded-full bg-[#d38aa9]\" data-kid=\"1-2-2-3-2-1-1-1\" data-name=\"layout 1 indicator\">\n                            </span>\n                            <span class=\"text-[12px] font-semibold text-[#e6e8eb]\" data-kid=\"1-2-2-3-2-1-1-2\" data-name=\"layout 1 title\">\n                                Layout 1\n                            </span>\n                            <span class=\"ml-auto whitespace-nowrap font-mono text-[11px] tabular-nums text-[#f0c8d8]\" data-kid=\"1-2-2-3-2-1-1-3\" data-name=\"layout 1 scale text\">\n                                1:500.000\n                            </span>\n      