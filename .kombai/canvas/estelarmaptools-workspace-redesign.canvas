      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-[#101214] text-[#e8eaed] font-['IBM_Plex_Sans',sans-serif] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"flex h-[58px] items-center justify-between border-b border-[#292d31] bg-[#151719] px-7\" data-kid=\"1-1\" data-name=\"top header bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand logo and title group\">\n            <img alt=\"EstelarMapTools\" class=\"h-9 w-9 shrink-0 rounded-lg object-contain\" data-kid=\"1-1-1-1\" data-name=\"application logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/ui/assets/logo.png\"/>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\" data-name=\"application identity container\">\n                <div class=\"truncate text-[15px] font-semibold tracking-[-0.01em] text-[#f4f5f6]\" data-kid=\"1-1-1-2-1\" data-name=\"application title\">\n                    EstelarMapTools\n                </div>\n                <div class=\"text-[12px] text-[#92979d]\" data-kid=\"1-1-1-2-2\" data-name=\"application subtitle\">\n                    Mapa de localização · QGIS\n                </div>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-2\" data-kid=\"1-1-2\" data-name=\"window control buttons\">\n            <button aria-label=\"Minimizar janela\" class=\"flex h-8 w-8 items-center justify-center rounded-md text-[#9ca2a9] hover:bg-[#23272b] hover:text-white\" data-kid=\"1-1-2-1\" data-name=\"minimize window button\">\n                <span class=\"text-[19px] leading-none\" data-kid=\"1-1-2-1-1\" data-name=\"minus icon\">\n                    −\n                </span>\n            </button>\n            <button aria-label=\"Fechar janela\" class=\"flex h-8 w-8 items-center justify-center rounded-md text-[#9ca2a9] hover:bg-[#3a2223] hover:text-white\" data-kid=\"1-1-2-2\" data-name=\"close window button\">\n                <span class=\"text-[20px] leading-none\" data-kid=\"1-1-2-2-1\" data-name=\"cross icon\">\n                    ×\n                </span>\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto flex max-w-[1600px] flex-col gap-0\" data-kid=\"1-2\" data-name=\"main application content area\">\n        <section aria-label=\"Preparação do projeto\" class=\"border-b border-[#292d31] bg-[#141719] px-7 py-4\" data-kid=\"1-2-1\" data-name=\"project configuration section\">\n            <div class=\"grid grid-cols-[minmax(220px,1.25fr)_minmax(180px,.9fr)_minmax(150px,.65fr)_minmax(270px,1.2fr)] gap-x-5\" data-kid=\"1-2-1-1\" data-name=\"configuration fields row\">\n                <label class=\"min-w-0\" data-kid=\"1-2-1-1-1\" data-name=\"work name field label\">\n                    <span class=\"mb-1.5 block text-[13px] font-medium text-[#b4bac1]\" data-kid=\"1-2-1-1-1-1\" data-name=\"label text\">\n                        Nome da obra\n                    </span>\n                    <div class=\"flex h-10 items-center rounded-md border border-[#373c41] bg-[#1c2023] px-3 focus-within:border-[#3b82f6]\" data-kid=\"1-2-1-1-1-2\" data-name=\"input field container\">\n                        <input aria-label=\"Nome da obra\" class=\"min-w-0 flex-1 bg-transparent text-[14px] text-[#f0f1f2] outline-none\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"work name input field\" value=\"Parque Solar Atacama\"/>\n                        <span class=\"ti ti-chevron-down ml-2 text-[14px] text-[#848b92]\" data-kid=\"1-2-1-1-1-2-2\" data-name=\"chevron down icon\">\n                        </span>\n                    </div>\n                </label>\n                <label class=\"min-w-0\" data-kid=\"1-2-1-1-2\" data-name=\"project type field label\">\n                    <span class=\"mb-1.5 block text-[13px] font-medium text-[#b4bac1]\" data-kid=\"1-2-1-1-2-1\" data-name=\"label text\">\n                        Perfil rápido / tipo\n                    </span>\n                    <div class=\"flex h-10 items-center rounded-md border border-[#373c41] bg-[#1c2023] px-3 focus-within:border-[#3b82f6]\" data-kid=\"1-2-1-1-2-2\" data-name=\"select field container\">\n                        <select aria-label=\"Perfil rápido e tipo de projeto\" class=\"min-w-0 flex-1 appearance-none bg-transparent text-[14px] text-[#f0f1f2] outline-none\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"project type select input\">\n                            <option data-kid=\"1-2-1-1-2-2-1-1\" data-name=\"project type option\">\n                                UFV · Usina fotovoltaica\n                            </option>\n                            <option data-kid=\"1-2-1-1-2-2-1-2\" data-name=\"project type option\">\n                                PCH\n                            </option>\n                            <option data-kid=\"1-2-1-1-2-2-1-3\" data-name=\"project type option\">\n                                UHE\n                            </option>\n                            <option data-kid=\"1-2-1-1-2-2-1-4\" data-name=\"project type option\">\n                                CGH\n                            </option>\n                            <option data-kid=\"1-2-1-1-2-2-1-5\" data-name=\"project type option\">\n                                Personalizado\n                            </option>\n                        </select>\n                        <span class=\"ti ti-chevron-down text-[14px] text-[#848b92]\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"chevron down icon\">\n                        </span>\n                    </div>\n                </label>\n                <label class=\"min-w-0\" data-kid=\"1-2-1-1-3\" data-name=\"utm zone field label\">\n                    <span class=\"mb-1.5 block text-[13px] font-medium text-[#b4bac1]\" data-kid=\"1-2-1-1-3-1\" data-name=\"label text\">\n                        Zona UTM\n                    </span>\n                    <div class=\"flex h-10 items-center rounded-md border border-[#373c41] bg-[#1c2023] px-3 focus-within:border-[#3b82f6]\" data-kid=\"1-2-1-1-3-2\" data-name=\"select field container\">\n                        <select aria-label=\"Zona UTM\" class=\"min-w-0 flex-1 appearance-none bg-transparent font-['IBM_Plex_Mono',monospace] text-[13px] text-[#f0f1f2] outline-none\" data-kid=\"1-2-1-1-3-2-1\" data-name=\"utm zone select input\">\n                            <option data-kid=\"1-2-1-1-3-2-1-1\" data-name=\"utm zone option\">\n                                19S\n                            </option>\n                            <option data-kid=\"1-2-1-1-3-2-1-2\" data-name=\"utm zone option\">\n                                Automático\n                            </option>\n                        </select>\n                        <span class=\"ti ti-chevron-down text-[14px] text-[#848b92]\" data-kid=\"1-2-1-1-3-2-2\" data-name=\"chevron down icon\">\n                        </span>\n                    </div>\n                </label>\n                <div class=\"flex min-w-0 items-end\" data-kid=\"1-2-1-1-4\" data-name=\"advanced settings container\">\n                    <button class=\"flex h-10 w-full items-center justify-between rounded-md border border-[#343a40] bg-[#1a1e21] px-3 text-left text-[13px] text-[#c7cbd0] hover:bg-[#202529]\" data-kid=\"1-2-1-1-4-1\" data-name=\"advanced settings button\">\n                        <span data-kid=\"1-2-1-1-4-1-1\" data-name=\"button text\">\n                            Configurações avançadas\n                        </span>\n                        <span class=\"ti ti-chevron-down text-[15px] text-[#899199]\" data-kid=\"1-2-1-1-4-1-2\" data-name=\"chevron down icon\">\n                        </span>\n                    </button>\n                </div>\n            </div>\n            <div class=\"mt-3.5 grid grid-cols-[minmax(260px,1fr)_minmax(300px,1.2fr)_minmax(250px,.9fr)] items-end gap-x-5\" data-kid=\"1-2-1-2\" data-name=\"file and path selection row\">\n                <div class=\"min-w-0\" data-kid=\"1-2-1-2-1\" data-name=\"kml file input group\">\n                    <div class=\"mb-1.5 text-[13px] font-medium text-[#b4bac1]\" data-kid=\"1-2-1-2-1-1\" data-name=\"label text\">\n                        Arquivo KML/KMZ\n                    </div>\n                    <div class=\"flex h-10 min-w-0 items-center gap-2 rounded-md border border-[#3a3f44] bg-[#1b1f22] px-3\" data-kid=\"1-2-1-2-1-2\" data-name=\"file input field container\">\n                        <span class=\"ti ti-map-pin text-[16px] text-[#a3aab1]\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"map pin icon\">\n                        </span>\n                        <span class=\"min-w-0 flex-1 truncate text-[13px] text-[#aeb4bb]\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"selected file text\">\n                            Nenhum arquivo selecionado\n                        </span>\n                        <button aria-label=\"Importar KML ou KMZ\" class=\"inline-flex h-8 shrink-0 items-center gap-1.5 rounded bg-[#252a2f] px-2.5 text-[12px] font-medium text-[#e3e6e9] hover:bg-[#30363c]\" data-kid=\"1-2-1-2-1-2-3\" data-name=\"import button\">\n                            <span class=\"ti ti-upload text-[14px]\" data-kid=\"1-2-1-2-1-2-3-1\" data-name=\"upload icon\">\n                            </span>\n                            Importar\n                        </button>\n                    </div>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-2-1-2-2\" data-name=\"destination path group\">\n                    <div class=\"mb-1.5 text-[13px] font-medium text-[#b4bac1]\" data-kid=\"1-2-1-2-2-1\" data-name=\"label text\">\n                        Pasta de destino\n                    </div>\n                    <div class=\"flex h-10 min-w-0 items-center gap-1 rounded-md border border-[#3a3f44] bg-[#1b1f22] pl-3 pr-1\" data-kid=\"1-2-1-2-2-2\" data-name=\"path selection container\">\n                        <span class=\"min-w-0 flex-1 truncate font-['IBM_Plex_Mono',monospace] text-[12px] text-[#8d949b]\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"selected path text\">\n                            Escolha uma pasta para salvar o projeto\n                        </span>\n                        <button aria-label=\"Selecionar pasta de destino\" class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded text-[#9ca3aa] hover:bg-[#2a3035] hover:text-white\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"select folder button\" title=\"Selecionar pasta\">\n                            <span class=\"ti ti-folder-open text-[16px]\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"folder open icon\">\n                            </span>\n                        </button>\n                        <button aria-label=\"Abrir pasta de destino\" class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded text-[#858c93] hover:bg-[#2a3035] hover:text-white\" data-kid=\"1-2-1-2-2-2-3\" data-name=\"open folder button\" title=\"Abrir pasta\">\n                            <span class=\"ti ti-external-link text-[15px]\" data-kid=\"1-2-1-2-2-2-3-1\" data-name=\"external link icon\">\n                            </span>\n                        </button>\n                        <button aria-label=\"Copiar caminho da pasta\" class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded text-[#858c93] hover:bg-[#2a3035] hover:text-white\" data-kid=\"1-2-1-2-2-2-4\" data-name=\"copy path button\" title=\"Copiar caminho\">\n                            <span class=\"ti ti-copy text-[15px]\" data-kid=\"1-2-1-2-2-2-4-1\" data-name=\"copy icon\">\n                            </span>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"flex min-h-10 items-center gap-2 border-l border-[#30353a] pl-4 text-[13px] leading-5 text-[#c2a968]\" data-kid=\"1-2-1-2-3\" data-name=\"warning message container\">\n                    <span class=\"ti ti-alert-circle shrink-0 text-[16px]\" data-kid=\"1-2-1-2-3-1\" data-name=\"alert icon\">\n                    </span>\n                    <span data-kid=\"1-2-1-2-3-2\" data-name=\"warning message text\">\n                        Para gerar: importe um KML/KMZ e escolha a pasta de destino.\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Visualização do mapa\" class=\"px-7 pt-4\" data-kid=\"1-2-2\" data-name=\"map preview section\">\n            <div class=\"relative h-[366px] overflow-hidden rounded-lg border border-[#30363b] bg-[#171a1c]\" data-kid=\"1-2-2-1\" data-name=\"map canvas container\">\n                <img alt=\"Imagem aérea de terreno e vale, por Kristian Møller no Unsplash; referência visual sem geometria do projeto carregada\" class=\"absolute inset-0 h-full w-full object-cover object-center brightness-[.78] saturate-[.78]\" data-kid=\"1-2-2-1-1\" data-name=\"map background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1729269768996-907c71346e8f?auto=format&w=1800&q=80&fit=crop\"/>\n                <div class=\"absolute inset-0 bg-gradient-to-b from-[#101619]/45 via-transparent to-[#101619]/30\" data-kid=\"1-2-2-1-2\" data-name=\"map gradient overlay\">\n                </div>\n                <div class=\"absolute left-4 top-4 flex h-9 items-center gap-2 rounded-md border border-white/15 bg-[#12171b]/85 px-3 text-[13px] text-[#e3e7ea]\" data-kid=\"1-2-2-1-3\" data-name=\"map layer switcher\">\n                    <span class=\"text-[#aeb6bd]\" data-kid=\"1-2-2-1-3-1\" data-name=\"base label\">\n                        Base\n                    </span>\n                    <span class=\"h-4 w-px bg-white/15\" data-kid=\"1-2-2-1-3-2\" data-name=\"separator line\">\n                    </span>\n                    <span class=\"font-medium\" data-kid=\"1-2-2-1-3-3\" data-name=\"selected layer name\">\n                        Satélite\n                    </span>\n                    <span class=\"ti ti-chevron-down text-[13px] text-[#aeb6bd]\" data-kid=\"1-2-2-1-3-4\" data-name=\"chevron down icon\">\n                    </span>\n                </div>\n                <div class=\"absolute right-4 top-4 flex items-center gap-1 rounded-md border border-white/15 bg-[#12171b]/78 p-1\" data-kid=\"1-2-2-1-4\" data-name=\"map settings toggle\">\n                    <button aria-label=\"Mapa base\" class=\"rounded px-2.5 py-1.5 text-[12px] text-[#b3bac1] hover:bg-white/10\" data-kid=\"1-2-2-1-4-1\" data-name=\"map view button\">\n                        Mapa\n                    </button>\n                    <button aria-label=\"Sem cidades\" class=\"rounded px-2.5 py-1.5 text-[12px] text-[#b3bac1] hover:bg-white/10\" data-kid=\"1-2-2-1-4-2\" data-name=\"no cities button\">\n                        Sem cidades\n                    </button>\n                </div>\n                <div class=\"absolute bottom-4 left-4 flex max-w-[460px] items-center gap-2 rounded-md border border-white/12 bg-[#101518]/82 px-3 py-2 text-[13px] text-[#e2e5e8]\" data-kid=\"1-2-2-1-5\" data-name=\"map status info container\">\n                    <span class=\"ti ti-info-circle shrink-0 text-[16px] text-[#aab2ba]\" data-kid=\"1-2-2-1-5-1\" data-name=\"info icon\">\n                    </span>\n                    <span data-kid=\"1-2-2-1-5-2\" data-name=\"info message text\">\n                        Base cartográfica de referência. Importe o KML/KMZ para visualizar a geometria da obra.\n                    </span>\n                </div>\n                <div class=\"absolute bottom-4 right-4 rounded bg-[#101518]/80 px-2.5 py-1.5 font-['IBM_Plex_Mono',monospace] text-[11px] text-[#d4d9dd]\" data-kid=\"1-2-2-1-6\" data-name=\"status banner\">\n                    Visualização sem geometria importada\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Controles das extensões de layout\" class=\"px-7 pt-3 pb-4\" data-kid=\"1-2-3\" data-name=\"layout extent controls section\">\n            <div class=\"rounded-lg border border-[#30363a] bg-[#171a1c] px-4 py-3\" data-kid=\"1-2-3-1\" data-name=\"layout controller card\">\n                <div class=\"mb-2.5 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-[12px]\" data-kid=\"1-2-3-1-1\" data-name=\"controls header\">\n                    <div class=\"flex flex-wrap items-center gap-x-5 gap-y-1.5 text-[#b7bdc3]\" data-kid=\"1-2-3-1-1-1\" data-name=\"layout legends group\">\n                        <span class=\"font-medium text-[#e2e5e8]\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"title text\">\n                            Extensões no mapa\n                        </span>\n                        <span class=\"flex items-center gap-1.5\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"layout legend item\">\n                            <i class=\"h-2.5 w-2.5 rounded-sm bg-[#e884a0]\" data-kid=\"1-2-3-1-1-1-2-1\" data-name=\"color indicator\">\n                            </i>\n                            Layout 1 · Área de estudo do recorte\n                        </span>\n                        <span class=\"flex items-center gap-1.5\" data-kid=\"1-2-3-1-1-1-3\" data-name=\"layout legend item\">\n                            <i class=\"h-2.5 w-2.5 rounded-sm bg-[#e9a362]\" data-kid=\"1-2-3-1-1-1-3-1\" data-name=\"color indicator\">\n                            </i>\n                            Layout 2\n                        </span>\n                        <span class=\"flex items-center gap-1.5\" data-kid=\"1-2-3-1-1-1-4\" data-name=\"layout legend item\">\n                            <i class=\"h-2.5 w-2.5 rounded-sm bg-[#64c39a]\" data-kid=\"1-2-3-1-1-1-4-1\" data-name=\"color indicator\">\n                            </i>\n                            Layout 3\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-1.5 text-[#9ba2a9]\" data-kid=\"1-2-3-1-1-2\" data-name=\"instructions group\">\n                        <span class=\"ti ti-arrows-move text-[15px]\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"move icon\">\n                        </span>\n                        Arraste o mapa para mover os layouts desbloqueados\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-[minmax(330px,1.05fr)_minmax(260px,.8fr)_minmax(280px,1.25fr)_120px] items-center gap-4 border-t border-[#30363a] py-2.5\" data-kid=\"1-2-3-1-2\" data-name=\"layout settings row\">\n                    <div class=\"flex min-w-0 items-center gap-2.5\" data-kid=\"1-2-3-1-2-1\" data-name=\"layout info group\">\n                        <i class=\"h-2.5 w-2.5 shrink-0 rounded-full bg-[#e884a0]\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"color indicator\">\n                        </i>\n                        <div class=\"min-w-0\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"layout name and info\">\n                            <div class=\"text-[13px] font-semibold text-[#f0d9df]\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"layout title\">\n                                LAYOUT 1\n                                <span class=\"font-normal text-[#d8a0ae]\" data-kid=\"1-2-3-1-2-1-2-1-1\" data-name=\"layout subtitle\">\n                                    · ROSA\n                                </span>\n                            </div>\n                            <div class=\"truncate text-[12px] text-[#aeb4ba]\" data-kid=\"1-2-3-1-2-1-2-2\" data-name=\"layout description\">\n                                Área de estudo usada no recorte\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"font-['IBM_Plex_Mono',monospace] text-[14px] font-medium tabular-nums text-[#e884a0]\" data-kid=\"1-2-3-1-2-2\" data-name=\"scale text\">\n                        1:500.000\n                    </div>\n                    <div class=\"relative flex h-6 items-center\" data-kid=\"1-2-3-1-2-3\" data-name=\"range slider container\">\n                        <div class=\"h-[3px] w-full rounded-full bg-[#3d4246]\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"slider track\">\n                        </div>\n                        <div class=\"absolute left-0 h-[3px] w-1/4 rounded-full bg-[#e884a0]\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"slider active track\">\n                        </div>\n                        <div class=\"absolute left-1/4 h-3.5 w-3.5 -translate-x-1/2 rounded-full border-2 border-[#171a1c] bg-[#e884a0] shadow-[0_0_0_1px_#e884a0]\" data-kid=\"1-2-3-1-2-3-3\" data-name=\"slider handle\">\n                        </div>\n                        <input aria-label=\"Escala Layout 1\" class=\"absolute inset-0 h-full w-full cursor-pointer opacity-0\" data-kid=\"1-2-3-1-2-3-4\" data-name=\"scale range input\" max=\"400\" min=\"1\" type=\"range\" value=\"100\"/>\n                    </div>\n                    <div class=\"flex items-center justify-end gap-2\" data-kid=\"1-2-3-1-2-4\" data-name=\"lock button group\">\n                        <button aria-label=\"Bloquear centro do Layout 1\" class=\"flex h-8 items-center gap-1.5 rounded-md border border-[#41464b] px-2.5 text-[12px] text-[#c7cbd0] hover:bg-[#252a2e]\" data-kid=\"1-2-3-1-2-4-1\" data-name=\"lock control button\" title=\"Centro desbloqueado; clique para bloquear\">\n                            <span class=\"ti ti-lock-open text-[15px] text-[#b7bdc3]\" data-kid=\"1-2-3-1-2-4-1-1\" data-name=\"lock icon\">\n                            </span>\n                            <span data-kid=\"1-2-3-1-2-4-1-2\" data-name=\"button text\">\n                                Livre\n                            </span>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-[minmax(330px,1.05fr)_minmax(260px,.8fr)_minmax(280px,1.25fr)_120px] items-center gap-4 border-t border-[#30363a] py-2.5\" data-kid=\"1-2-3-1-3\" data-name=\"layout settings row\">\n                    <div class=\"flex min-w-0 items-center gap-2.5\" data-kid=\"1-2-3-1-3-1\" data-name=\"layout info group\">\n                        <i class=\"h-2.5 w-2.5 shrink-0 rounded-full bg-[#e9a362]\" data-kid=\"1-2-3-1-3-1-1\" data-name=\"color indicator\">\n                        </i>\n                        <div class=\"text-[13px] font-semibold text-[#f3dfcb]\" data-kid=\"1-2-3-1-3-1-2\" data-name=\"layout title\">\n                            LAYOUT 2\n                            <span class=\"font-normal text-[#d9ac7f]\" data-kid=\"1-2-3-1-3-1-2-1\" data-name=\"layout subtitle\">\n                                · LARANJA\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"font-['IBM_Plex_Mono',monospace] text-[14px] font-medium tabular-nums text-[#e9a362]\" data-kid=\"1-2-3-1-3-2\" data-name=\"scale text\">\n                        1:100.000\n                    </div>\n                    <div class=\"relative flex h-6 items-center\" data-kid=\"1-2-3-1-3-3\" data-name=\"range slider container\">\n                        <div class=\"h-[3px] w-full rounded-full bg-[#3d4246]\" data-kid=\"1-2-3-1-3-3-1\" data-name=\"slider track\">\n                        </div>\n                        <div class=\"absolute left-0 h-[3px] w-[5%] rounded-full bg-[#e9a362]\" data-kid=\"1-2-3-1-3-3-2\" data-name=\"slider active track\">\n                        </div>\n                        <div class=\"absolute left-[5%] h-3.5 w-3.5 -translate-x-1/2 rounded-full border-2 border-[#171a1c] bg-[#e9a362] shadow-[0_0_0_1px_#e9a362]\" data-kid=\"1-2-3-1-3-3-3\" data-name=\"slider handle\">\n                        </div>\n                        <input aria-label=\"Escala Layout 2\" class=\"absolute inset-0 h-full w-full cursor-pointer opacity-0\" data-kid=\"1-2-3-1-3-3-4\" data-name=\"scale range input\" max=\"400\" min=\"1\" type=\"range\" value=\"20\"/>\n                    </div>\n                    <div class=\"flex items-center justify-end gap-2\" data-kid=\"1-2-3-1-3-4\" data-name=\"lock button group\">\n                        <button aria-label=\"Bloquear centro do Layout 2\" class=\"flex h-8 items-center gap-1.5 rounded-md border border-[#41464b] px-2.5 text-[12px] text-[#c7cbd0] hover:bg-[#252a2e]\" data-kid=\"1-2-3-1-3-4-1\" data-name=\"lock control button\" title=\"Centro desbloqueado; clique para bloquear\">\n                            <span class=\"ti ti-lock-open text-[15px] text-[#b7bdc3]\" data-kid=\"1-2-3-1-3-4-1-1\" data-name=\"lock icon\">\n                            </span>\n                            <span data-kid=\"1-2-3-1-3-4-1-2\" data-name=\"button text\">\n                                Livre\n                            </span>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-[minmax(330px,1.05fr)_minmax(260px,.8fr)_minmax(280px,1.25fr)_120px] items-center gap-4 border-t border-[#30363a] py-2.5\" data-kid=\"1-2-3-1-4\" data-name=\"layout settings row\">\n                    <div class=\"flex min-w-0 items-center gap-2.5\" data-kid=\"1-2-3-1-4-1\" data-name=\"layout info group\">\n                        <i class=\"h-2.5 w-2.5 shrink-0 rounded-full bg-[#64c39a]\" data-kid=\"1-2-3-1-4-1-1\" data-name=\"color indicator\">\n                        </i>\n                        <div class=\"text-[13px] font-semibold text-[#d7eee3]\" data-kid=\"1-2-3-1-4-1-2\" data-name=\"layout title\">\n                            LAYOUT 3\n                            <span class=\"font-normal text-[#91c5aa]\" data-kid=\"1-2-3-1-4-1-2-1\" data-name=\"layout subtitle\">\n                                · VERDE\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"font-['IBM_Plex_Mono',monospace] text-[14px] font-medium tabular-nums text-[#64c39a]\" data-kid=\"1-2-3-1-4-2\" data-name=\"scale text\">\n                        1:25.000\n                    </div>\n                    <div class=\"relative flex h-6 items-center\" data-kid=\"1-2-3-1-4-3\" data-name=\"range slider container\">\n                        <div class=\"h-[3px] w-full rounded-full bg-[#3d4246]\" data-kid=\"1-2-3-1-4-3-1\" data-name=\"slider track\">\n                        </div>\n                        <div class=\"absolute left-0 h-[3px] w-[1.25%] rounded-full bg-[#64c39a]\" data-kid=\"1-2-3-1-4-3-2\" data-name=\"slider active track\">\n                        </div>\n                        <div class=\"absolute left-[1.25%] h-3.5 w-3.5 -translate-x-1/2 rounded-full border-2 border-[#171a1c] bg-[#64c39a] shadow-[0_0_0_1px_#64c39a]\" data-kid=\"1-2-3-1-4-3-3\" data-name=\"slider handle\">\n                        </div>\n                        <input aria-label=\"Escala Layout 3\" class=\"absolute inset-0 h-full w-full cursor-pointer opacity-0\" data-kid=\"1-2-3-1-4-3-4\" data-name=\"scale range input\" max=\"400\" min=\"1\" type=\"range\" value=\"5\"/>\n                    </div>\n                    <div class=\"flex items-center justify-end gap-2\" data-kid=\"1-2-3-1-4-4\" data-name=\"lock button group\">\n                        <button aria-label=\"Bloquear centro do Layout 3\" class=\"flex h-8 items-center gap-1.5 rounded-md border border-[#41464b] px-2.5 text-[12px] text-[#c7cbd0] hover:bg-[#252a2e]\" data-kid=\"1-2-3-1-4-4-1\" data-name=\"lock control button\" title=\"Centro desbloqueado; clique para bloquear\">\n                            <span class=\"ti ti-lock-open text-[15px] text-[#b7bdc3]\" data-kid=\"1-2-3-1-4-4-1-1\" data-name=\"lock icon\">\n                            </span>\n                            <span data-kid=\"1-2-3-1-4-4-1-2\" data-name=\"button text\">\n                                Livre\n                            </span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"flex min-h-[66px] items-center justify-between border-t border-[#2d3236] bg-[#151719] px-7\" data-kid=\"1-3\" data-name=\"footer control bar\">\n        <button aria-label=\"Resetar template\" class=\"inline-flex h-9 items-center gap-2 rounded-md px-2 text-[13px] font-medium text-[#a2a8ae] hover:bg-[#24282b] hover:text-[#e4e7e9]\" data-kid=\"1-3-1\" data-name=\"reset template button\">\n            <span class=\"ti ti-rotate-2 text-[16px]\" data-kid=\"1-3-1-1\" data-name=\"reset icon\">\n            </span>\n            Resetar template\n        </button>\n        <div class=\"flex items-center gap-4\" data-kid=\"1-3-2\" data-name=\"action container\">\n            <span class=\"text-[12px] text-[#969da4]\" data-kid=\"1-3-2-1\" data-name=\"instruction message\">\n                Importe um arquivo e selecione a pasta de destino para continuar.\n            </span>\n            <button aria-disabled=\"true\" class=\"inline-flex h-10 min-w-[174px] items-center justify-center gap-2 rounded-md border border-[#343a40] bg-[#22272b] px-4 text-[13px] font-semibold text-[#858c92]\" data-kid=\"1-3-2-2\" data-name=\"generate project button\" disabled=\"\">\n                <span class=\"ti ti-player-play-filled text-[14px]\" data-kid=\"1-3-2-2-1\" data-name=\"play icon\">\n                </span>\n                Gerar projeto\n            </button>\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-10-01T00:01:16.409056+00:00",
      "modified": "2026-10-01T00:03:17.139209+00:00",
