/* EstelarMapTools — fluent-inspired dark workspace */
QDialog {
    background-color: #111112;
    color: #f5f5f5;
    border: 1px solid #2b2b2d;
    border-radius: 12px;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 9pt;
}

QLabel {
    color: #f0f0f0;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    width: 8px;
    margin: 2px;
    background: transparent;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    background: #3b3b3e;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #56565b;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

/* Header */
#titleBar {
    background-color: #171719;
    border: none;
    border-radius: 0;
}

#dialogTitle {
    color: #f5f5f5;
    font-size: 12pt;
    font-weight: 700;
}

#dialogSubtitle {
    color: #858589;
    font-size: 8.5pt;
}

#panelHeading,
#sidePanelHeading {
    color: #f2f2f3;
    font-size: 9pt;
    font-weight: 700;
}

#statusPill {
    color: #a1a1a5;
    background-color: #262629;
    border-radius: 9px;
    padding: 3px 8px;
    font-size: 7pt;
}

#logHeading {
    color: #89898e;
    font-size: 8pt;
    font-weight: 700;
}

#headerDivider {
    max-height: 1px;
    border: none;
    background-color: #2b2b2d;
}

#btnMinimize,
#btnClose {
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0;
    color: #c8c8ca;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
}

#btnMinimize:hover {
    background-color: #252529;
    border-color: #3a3a3e;
}

#btnClose:hover {
    color: #ffffff;
    background-color: #a83232;
    border-color: #c94747;
}

/* Three-pane workspace */
#hubSurface {
    background-color: #111112;
    border: none;
}

QScrollArea#hubCard {
    background-color: #121214;
    border: none;
    border-right: 1px solid #2b2b2d;
}

QScrollArea#validationPane {
    background-color: #121214;
    border: none;
}

QScrollArea#hubMapCard {
    background-color: #111112;
    border: none;
    border-right: 1px solid #2b2b2d;
}

QWidget#validationContent {
    background-color: transparent;
}

/* Cards and section headings */
QGroupBox {
    color: #f0f0f0;
    background-color: #19191b;
    border: 1px solid #2c2c30;
    border-radius: 12px;
    margin-top: 12px;
    padding: 9px 8px 8px 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #a3a3a7;
    background-color: #19191b;
    font-size: 8pt;
    font-weight: 700;
}

#summaryPanel {
    background-color: #171719;
    border-color: #29292c;
}

#summaryPanel::title {
    background-color: #171719;
}

#summaryItem {
    color: #a6a6aa;
    padding: 2px 0;
}

/* Form controls */
QLineEdit,
QComboBox,
QDoubleSpinBox {
    min-height: 28px;
    padding: 4px 8px;
    color: #eeeeef;
    background-color: #1c1c1f;
    border: 1px solid #343438;
    border-radius: 8px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}

QLineEdit:hover,
QComboBox:hover,
QDoubleSpinBox:hover {
    border-color: #4a4a50;
}

QLineEdit:focus,
QComboBox:focus,
QDoubleSpinBox:focus {
    background-color: #202024;
    border: 1px solid #3b82f6;
}

QLineEdit[validationState="missing"],
QComboBox[validationState="missing"],
QPushButton[validationState="missing"] {
    border: 1px solid #e05252;
}

QLineEdit:disabled,
QComboBox:disabled,
QDoubleSpinBox:disabled {
    color: #77777b;
    background-color: #18181a;
    border-color: #29292c;
}

QComboBox::drop-down {
    width: 28px;
    background-color: transparent;
    border: none;
    border-left: 1px solid #333337;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox::drop-down:hover {
    background-color: rgba(59, 130, 246, 24);
    border-left-color: #3b82f6;
}

QComboBox QAbstractItemView,
QAbstractItemView#obraCompleterPopup {
    color: #eeeeef;
    background-color: #1b1b1e;
    border: 1px solid #3b82f6;
    border-radius: 8px;
    outline: none;
    selection-background-color: #2d5fa8;
    selection-color: #ffffff;
}

QComboBox QAbstractItemView::item,
QAbstractItemView#obraCompleterPopup::item {
    min-height: 28px;
    padding: 5px 10px;
}

QComboBox QAbstractItemView::item:hover,
QAbstractItemView#obraCompleterPopup::item:hover {
    background-color: #252529;
}

QCheckBox {
    spacing: 9px;
    color: #e7e7e9;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background-color: #202023;
    border: 1px solid #48484d;
    border-radius: 6px;
}

QCheckBox::indicator:hover {
    border-color: #3b82f6;
}

QCheckBox::indicator:checked {
    background-color: #3b82f6;
    border-color: #3b82f6;
}

#fieldLabel {
    color: #89898e;
    font-size: 8pt;
    font-weight: 600;
}

#destinationHint {
    color: #77777b;
    font-size: 8pt;
}

/* Actions */
QPushButton {
    min-height: 30px;
    padding: 6px 10px;
    color: #e8e8ea;
    background-color: #202023;
    border: 1px solid #36363a;
    border-radius: 8px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #29292d;
    border-color: #4b4b51;
}

QPushButton:pressed {
    background-color: #171719;
}

QPushButton:focus,
QCheckBox:focus {
    border: 1px solid #3b82f6;
}

QPushButton:disabled {
    color: #6f6f73;
    background-color: #1a1a1c;
    border-color: #29292c;
}

#btnImportKml {
    min-height: 58px;
    color: #e5e5e7;
    background-color: #171719;
    border: 1px dashed #44444a;
    border-radius: 12px;
}

#btnImportKml:hover {
    background-color: #1b2029;
    border-color: #3b82f6;
}

#btnImportKml[validationState="missing"] {
    border-color: #e05252;
}

#folderPickerButton,
#openProjectFolderButton,
#copyProjectPathButton {
    min-width: 34px;
    max-width: 34px;
    min-height: 32px;
    max-height: 32px;
    padding: 0;
}

#btnGerar {
    min-width: 190px;
    min-height: 46px;
    padding: 8px 20px;
    color: #ffffff;
    background-color: #3b82f6;
    border: 1px solid #3b82f6;
    border-radius: 15px;
    font-size: 10pt;
    font-weight: 700;
}

#btnGerar:hover {
    background-color: #4b8ff8;
    border-color: #65a0ff;
}

#btnGerar:pressed {
    background-color: #2868d4;
}

#btnGerar:disabled {
    color: #7a8ca5;
    background-color: #202a39;
    border-color: #303b4c;
}

#btnReset {
    min-height: 40px;
    color: #a6a6aa;
    background-color: transparent;
    border-color: transparent;
}

#btnReset:hover {
    color: #eeeeef;
    background-color: #202023;
    border-color: #36363a;
}

#actionBar {
    background-color: #19191b;
    border-top: 1px solid #2b2b2d;
}

/* Live validation */
#validationPanel {
    margin: 0;
    padding: 0;
    background-color: transparent;
    border: none;
}

#validationScore {
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    color: #e8f1ff;
    background-color: #171a20;
    border: 2px solid #3b82f6;
    border-radius: 20px;
    font-size: 8pt;
    font-weight: 700;
}

QFrame#validationRow {
    min-height: 40px;
    background-color: #19191b;
    border: 1px solid #2c2c30;
    border-radius: 11px;
}

QFrame#validationRow[state="ready"] {
    background-color: #15191a;
    border-color: #263437;
}

QFrame#validationRow[state="pending"] {
    background-color: #19191b;
    border-color: #2c2c30;
}

#validationIndicator {
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    color: #858589;
    background-color: #29292c;
    border-radius: 11px;
    font-size: 9pt;
    font-weight: 700;
}

#validationIndicator[state="ready"] {
    color: #091b16;
    background-color: #10b981;
}

#validationLabel {
    color: #bdbdc1;
    font-size: 8.5pt;
}

QFrame#validationRow[state="ready"] #validationLabel {
    color: #e5e5e7;
}

/* Map and overlays */
#mapCanvas {
    background-color: #202024;
    border: 1px solid #303034;
    border-radius: 20px;
}

#mapOverlay {
    background: transparent;
}

#previewInfo {
    max-width: 260px;
    color: #f0f0f0;
    background-color: rgba(25, 25, 27, 225);
    border: 1px solid rgba(70, 70, 74, 230);
    border-radius: 12px;
    padding: 9px 12px;
    font-size: 8pt;
}

#summaryInfo {
    color: #a7a7ab;
    background: transparent;
    border: none;
    padding: 0;
    font-size: 8pt;
}

#mapStylePanel {
    background-color: rgba(28, 28, 31, 238);
    border: 1px solid rgba(70, 70, 74, 220);
    border-radius: 12px;
    margin: 10px;
}

#mapStyleLabel {
    color: #a1a1a6;
    font-size: 8pt;
    font-weight: 600;
}

#scalePanel {
    background-color: rgba(28, 28, 31, 242);
    border: 1px solid rgba(70, 70, 74, 230);
    border-radius: 18px;
    padding: 8px 10px;
    margin: 12px;
}

#scaleTitle {
    color: #bdbdc1;
    font-size: 8pt;
    font-weight: 600;
}

#scaleValue {
    min-width: 112px;
    padding: 4px 8px;
    color: #72a9ff;
    background-color: transparent;
    border: none;
    font-size: 8.5pt;
    font-weight: 700;
}

#layoutLockButton {
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
    padding: 0;
    background-color: #252529;
    border: 1px solid #3b3b40;
    border-radius: 8px;
}

#layoutLockButton:hover {
    background-color: #29364a;
    border-color: #3b82f6;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #38383c;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #3b82f6;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -5px 0;
    background-color: #3b82f6;
    border: 2px solid #19191b;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #69a1ff;
}

#statusInfo {
    color: #a3a3a7;
    background-color: #171719;
    border: 1px solid #2d2d31;
    border-radius: 9px;
    padding: 7px 8px;
}

/* Generation summary and system log */
#logPanel {
    min-height: 120px;
    color: #b9b9bd;
    background-color: #171719;
    border: 1px solid #2c2c30;
    border-radius: 12px;
    padding: 10px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 8pt;
}

#generationFlow {
    background-color: transparent;
    border: none;
    padding: 0;
}

#flowLabel {
    color: #a3a3a7;
    font-size: 8pt;
    font-weight: 600;
}

#generationStep {
    min-height: 12px;
    background: transparent;
    border: none;
}

#generationStep[state="active"],
#generationStep[state="done"],
#generationStep[state="pending"] {
    background: transparent;
    border: none;
}

#generationStepNumber {
    color: #dddddf;
    background-color: #343438;
    border-radius: 8px;
    font-size: 6pt;
    font-weight: 700;
}

#generationStepNumber[state="active"] {
    color: #ffffff;
    background-color: #3b82f6;
}

#generationStepNumber[state="done"] {
    color: #071d16;
    background-color: #10b981;
}

#generationStepText {
    color: #89898e;
    font-size: 7pt;
}

#generationStepText[state="active"] {
    color: #8db8ff;
}

#generationStepText[state="done"] {
    color: #b6e7d5;
}

QProgressBar {
    min-height: 3px;
    max-height: 3px;
    color: transparent;
    background-color: #29292c;
    border: none;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #3b82f6;
    border-radius: 2px;
}

#layoutCard {
    background-color: rgba(37, 37, 41, 220);
    border: 1px solid rgba(62, 62, 67, 220);
    border-radius: 11px;
    padding: 1px;
}

/* Footer */
#footerNote {
    color: #77777b;
    font-size: 8pt;
}

#windowResizeGrip {
    background-color: transparent;
    border-right: 2px solid #45454a;
    border-bottom: 2px solid #45454a;
    border-bottom-right-radius: 3px;
}

#windowResizeGrip:hover {
    border-right-color: #3b82f6;
    border-bottom-color: #3b82f6;
}
