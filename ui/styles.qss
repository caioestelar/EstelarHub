QDialog {
    background-color: #252a30;
    color: #eef2f3;
    border: 1px solid #344b83;
    border-radius: 12px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QTextEdit {
    background-color: #1f272b;
    color: #eef2f3;
    border: 1px solid #3d4a50;
    border-radius: 6px;
    padding: 6px;
}

QCheckBox {
    color: #dfe7ea;
    spacing: 8px;
}

QLabel {
    color: #d7e0e3;
    font-size: 9pt;
}

#dialogTitle {
    color: #f3f6f6;
    font-size: 12pt;
    font-weight: bold;
}

#dialogSubtitle {
    color: #9fb5e8;
    font-size: 9.5pt;
}

#headerDivider {
    max-height: 1px;
    border: none;
    background-color: #414b52;
}

#titleBar {
    background-color: #1b2327;
    border: 1px solid #1e49b1;
    border-left: 3px solid #f9620f;
    border-radius: 6px;
}

#btnMinimize,
#btnClose {
    background-color: #2d373d;
    color: #e5ecee;
    border: 1px solid #4d5a60;
    border-radius: 5px;
    font-size: 13pt;
    font-weight: bold;
    padding: 0;
}

#btnMinimize:hover {
    background-color: #294887;
    border-color: #5278d1;
}

#btnClose:hover {
    background-color: #f9620f;
    border-color: #ff8a4a;
}

QLineEdit,
QComboBox,
QDoubleSpinBox {
    background-color: #30383f;
    color: #eef2f3;
    border: 1px solid #4b5860;
    border-radius: 5px;
    padding: 6px 9px;
    min-height: 28px;
}

QLineEdit:focus,
QComboBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #1e49b1;
    background-color: #30394a;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    background-color: #303b50;
    border-left: 1px solid #435b91;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::drop-down:hover {
    background-color: #3a4f78;
    border-left-color: #f9620f;
}

QComboBox:editable QLineEdit {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 6px 9px;
}

QComboBox QAbstractItemView,
QAbstractItemView#obraCompleterPopup {
    background-color: #252a30;
    color: #eef2f3;
    border: 1px solid #1e49b1;
    border-radius: 5px;
    outline: none;
    selection-background-color: #1e49b1;
    selection-color: white;
}

QComboBox QAbstractItemView::item,
QAbstractItemView#obraCompleterPopup::item {
    min-height: 26px;
    padding: 5px 9px;
    border-bottom: 1px solid #343b45;
}

QComboBox QAbstractItemView::item:hover,
QAbstractItemView#obraCompleterPopup::item:hover {
    background-color: #303b50;
}

QSlider::groove:horizontal {
    height: 6px;
    background-color: #465158;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background-color: #1e49b1;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    margin: -6px 0;
    background-color: #edf4f3;
    border: 2px solid #f9620f;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #ffd0b5;
}

QPushButton {
    background-color: #303b50;
    color: white;
    border: 1px solid #435b91;
    border-radius: 6px;
    padding: 8px 12px;
    font-weight: 600;
    min-height: 34px;
}

QPushButton:hover {
    background-color: #3a4f78;
}

QPushButton:pressed {
    background-color: #243146;
}

QPushButton:disabled {
    color: #7d898e;
    background-color: #30363b;
    border-color: #3b4449;
}

QGroupBox {
    border: 1px solid #3d474d;
    border-radius: 6px;
    margin-top: 7px;
    background-color: #2b3137;
    padding-top: 6px;
    color: #eef2f3;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 7px;
    color: #ff8a4a;
    font-weight: bold;
}

QTabWidget::pane {
    border: 1px solid #3b474d;
    border-radius: 7px;
    background-color: #252a30;
    padding: 6px;
}

QTabBar::tab {
    background-color: #2b3237;
    color: #c4d0d4;
    padding: 6px 12px;
    min-width: 90px;
    border: 1px solid #3d474d;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    margin-right: 3px;
}

QTabBar::tab:selected {
    background-color: #1e49b1;
    color: white;
    font-weight: bold;
    border-bottom: 2px solid #f9620f;
}

QTabBar::tab:hover {
    background-color: #3b474d;
}

#statusInfo {
    color: #d9e5e6;
    background-color: #232c30;
    border: 1px solid #3e4e70;
    border-left: 3px solid #f9620f;
    border-radius: 5px;
    padding: 7px 9px;
}

#destinationHint {
    color: #9eafb5;
    font-size: 8pt;
}

#btnReset {
    background-color: #2b3444;
    color: #ffc19e;
    border: 1px solid #a84f20;
    font-weight: 600;
}

#btnReset:hover {
    background-color: #3b4659;
}

#btnGerar {
    background-color: #f9620f;
    color: white;
    font-size: 10.5pt;
    min-height: 40px;
    border: 1px solid #ff8a4a;
    font-weight: 700;
}

#btnGerar:hover {
    background-color: #ff7a2c;
}

#previewInfo {
    color: #e4eeee;
    background-color: rgba(23, 29, 33, 200);
    border: 1px solid rgba(64, 80, 79, 220);
    border-left: 3px solid #1e49b1;
    border-radius: 6px;
    padding: 7px 9px;
    font-size: 8.2pt;
}

#summaryPanel {
    border: 1px solid #3d4d52;
    border-radius: 7px;
    background-color: #2b3237;
}

#summaryItem {
    color: #dfe8ea;
    padding: 3px 0px;
}

#logPanel {
    background-color: #1d2428;
    border: 1px solid #3c4d52;
    border-radius: 6px;
}

#scaleValue {
    min-width: 112px;
    padding: 4px 8px;
    color: #ffd0b5;
    background-color: #293753;
    border: 1px solid #1e49b1;
    border-radius: 4px;
    font-weight: bold;
    font-size: 8.5pt;
}

#scaleTitle {
    color: #dfe7ea;
    font-weight: 600;
    font-size: 8.5pt;
}

#fieldLabel {
    color: #dfe7ea;
    font-weight: 600;
    font-size: 8.5pt;
}

#mapOverlay {
    background: transparent;
}

#scalePanel {
    background-color: rgba(17, 22, 27, 180);
    border: 1px solid rgba(92, 110, 117, 220);
    border-radius: 10px;
    padding: 6px 8px;
    margin: 10px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.25);
}

#mapStylePanel {
    background-color: rgba(16, 21, 26, 180);
    border: 1px solid rgba(92, 110, 117, 170);
    border-radius: 6px;
    margin: 7px;
    min-width: 150px;
}

#mapStyleLabel {
    color: #dfe7ea;
    font-weight: 600;
    font-size: 8pt;
}

#generationFlow {
    background-color: transparent;
    border: none;
    padding: 0px;
}

#flowLabel {
    color: #dfe7ea;
    font-weight: 600;
    font-size: 7.5pt;
    letter-spacing: 0.1px;
    margin-bottom: 0px;
}

#generationStep {
    background-color: transparent;
    border: none;
    min-height: 12px;
}

#generationStep[state="active"] {
    background-color: transparent;
    border: none;
}

#generationStep[state="done"] {
    background-color: transparent;
    border: none;
}

#generationStep[state="pending"] {
    background-color: transparent;
    border: none;
}

#generationStepNumber {
    background-color: rgba(62, 74, 81, 180);
    color: #edf6f5;
    border-radius: 4px;
    font-weight: bold;
    font-size: 5.2pt;
}

#generationStepNumber[state="active"] {
    background-color: #f9620f;
    color: white;
}

#generationStepNumber[state="done"] {
    background-color: #2fb46f;
    color: white;
}

#generationStepText {
    color: rgba(223, 235, 237, 180);
    font-weight: 500;
    font-size: 6.1pt;
}

#generationStepText[state="active"] {
    color: #ffb183;
}

#generationStepText[state="done"] {
    color: #d7f9e8;
}

QProgressBar {
    border: none;
    background-color: transparent;
    text-align: center;
    color: transparent;
    min-height: 2px;
    max-height: 2px;
    margin: 0px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1e49b1, stop:1 #f9620f);
    border-radius: 1px;
}

QComboBox#mapStylePanel {
    min-height: 22px;
    font-size: 8pt;
}

#layoutCard {
    background-color: rgba(42, 48, 54, 220);
    border: 1px solid rgba(63, 75, 82, 220);
    border-radius: 6px;
    margin: 0px;
}

